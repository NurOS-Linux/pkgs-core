pkgname=libvpx
pkgver=1.17.0
pkgrel=1
pkgdesc="VP8 and VP9 video codec library"
arch=('x86_64')
url="https://www.webmproject.org/code/"
license=('BSD-3-Clause')
depends=('glibc')
makedepends=('nasm' 'perl')
source=("https://github.com/webmproject/libvpx/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  ./configure \
    --prefix=/usr \
    --enable-shared \
    --enable-pic \
    --enable-vp8 \
    --enable-vp9 \
    --enable-postproc \
    --enable-runtime-cpu-detect \
    --disable-examples \
    --disable-unit-tests
  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
