pkgname=libwacom
pkgver=2.20.0
pkgrel=1
pkgdesc="Library to identify graphics tablets and their features"
arch=('x86_64')
url="https://github.com/linuxwacom/libwacom"
license=('MIT')
depends=('glibc' 'glib' 'libgudev' 'libevdev' 'eudev')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://github.com/linuxwacom/libwacom/releases/download/${pkgname}-${pkgver}/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release \
    -Dtests=disabled \
    -Ddocumentation=disabled \
    -Dudev-dir=/usr/lib/udev

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
