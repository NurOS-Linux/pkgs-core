pkgname=mpv
pkgver=0.36.0
pkgrel=1
pkgdesc="Command line video player"
arch=('x86_64')
url="https://mpv.io/"
license=('GPL-2.0-or-later')
depends=(
  'glibc' 'ffmpeg' 'alsa-lib' 'libx11' 'libxext' 'libxrandr'
  'libxinerama' 'libxkbcommon' 'libass' 'libxscrnsaver' 'libxpresent'
)
makedepends=('meson' 'ninja' 'pkgconf' 'python')
source=("https://github.com/mpv-player/mpv/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  # FFmpeg 7.x const uint8_t write_packet compatibility
  sed -i 's/static int write_packet(void \*p, uint8_t \*buf, int buf_size)/static int write_packet(void *p, const uint8_t *buf, int buf_size)/' audio/decode/ad_spdif.c
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --buildtype=release \
    -Dalsa=enabled \
    -Dx11=enabled \
    -Dlibplacebo=disabled \
    -Dlibplacebo-next=disabled \
    -Dwayland=disabled \
    -Ddrm=disabled \
    -Dmanpage-build=disabled

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
  rm -f "${pkgdir}/usr/share/info/dir"
}
