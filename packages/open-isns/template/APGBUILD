pkgname=open-isns
pkgver=0.103
pkgrel=1
pkgdesc="Internet Storage Name Service library and daemon"
arch=('x86_64')
url="https://github.com/open-iscsi/open-isns"
license=('LGPL-2.1-or-later')
depends=('glibc' 'openssl')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://github.com/open-iscsi/open-isns/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
