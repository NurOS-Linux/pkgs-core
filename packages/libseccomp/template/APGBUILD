pkgname=libseccomp
pkgver=2.6.1
pkgrel=1
pkgdesc="An enhanced seccomp library and container sandbox layer"
arch=('x86_64')
url="https://github.com/seccomp/libseccomp"
license=('LGPL-2.1-only')
depends=('glibc')
makedepends=('gperf')
source=("https://github.com/seccomp/libseccomp/releases/download/v${pkgver}/libseccomp-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sbindir=/usr/bin \
    --disable-static

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
