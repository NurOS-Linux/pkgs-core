pkgname=libnetfilter_conntrack
pkgver=1.1.1
pkgrel=1
pkgdesc="Library providing an API to the in-kernel connection tracking state table"
arch=('x86_64')
url="https://netfilter.org/projects/libnetfilter_conntrack/"
license=('GPL-2.0-or-later')
depends=('glibc' 'libnfnetlink' 'libmnl')
makedepends=('pkgconf')
source=("https://www.netfilter.org/projects/libnetfilter_conntrack/files/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --disable-static

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
