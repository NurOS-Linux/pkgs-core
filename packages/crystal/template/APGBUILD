pkgname=crystal
pkgver=1.21.0
pkgrel=1
pkgdesc="A statically typed, compiled language with Ruby-like syntax"
arch=('x86_64')
url="https://crystal-lang.org/"
license=('Apache-2.0')
depends=('glibc' 'gcc' 'gc' 'pcre2' 'libevent' 'llvm')
makedepends=('sh')
source=("https://github.com/crystal-lang/crystal/releases/download/${pkgver}/crystal-${pkgver}-1-linux-x86_64.tar.gz")

package() {
  cd "${srcdir}/crystal-${pkgver}-1"
  install -dm755 "${pkgdir}/usr"
  cp -r bin lib share "${pkgdir}/usr/"
}
