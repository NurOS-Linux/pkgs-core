pkgname=gettext
pkgver=1.0
pkgrel=1
pkgdesc="GNU internationalization utilities"
arch=('x86_64')
url="https://www.gnu.org/software/gettext/"
license=('GPL-3.0-or-later' 'LGPL-2.1-or-later')
depends=('glibc' 'ncurses' 'xz' 'bzip2')
source=("https://ftp.gnu.org/gnu/gettext/gettext-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --disable-static \
    --enable-threads=posix \
    --enable-shared \
    --without-emacs \
    --without-git

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" AM_UPDATE_INFO_DIR=no install
}
