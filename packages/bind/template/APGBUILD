pkgname=bind
pkgver=9.20.29
pkgrel=1
pkgdesc="A complete, highly portable implementation of the DNS protocol"
arch=('x86_64')
url="https://www.isc.org/bind/"
license=('MPL-2.0')
depends=('glibc' 'openssl' 'libuv' 'libnghttp2' 'libxml2' 'libcap')
makedepends=('pkgconf')
provides=('dnsutils' 'dig' 'nslookup')
source=("https://downloads.isc.org/isc/bind9/${pkgver}/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --sbindir=/usr/bin \
    --disable-doh
  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
