pkgname=jj
pkgver=0.45.1
pkgrel=1
pkgdesc="A Git-compatible VCS that is both simple and powerful"
arch=('x86_64')
url="https://github.com/martinvonz/jj"
license=('Apache-2.0')
depends=('glibc' 'gcc' 'openssl' 'zlib')
makedepends=('cargo' 'pkgconf')
provides=('jujutsu')
source=("https://github.com/martinvonz/jj/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  cargo build --frozen --release --bin jj
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -Dm755 "target/release/jj" "${pkgdir}/usr/bin/jj"
}
