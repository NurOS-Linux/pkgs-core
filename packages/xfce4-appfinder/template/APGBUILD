pkgname=xfce4-appfinder
pkgver=4.18.1
pkgrel=1
pkgdesc="An application finder for the Xfce desktop environment"
arch=('x86_64')
url="https://docs.xfce.org/xfce/xfce4-appfinder/start"
license=('GPL-2.0-or-later')
depends=('glibc' 'glib' 'gtk3' 'libxfce4util' 'libxfce4ui' 'xfconf' 'garcon')
makedepends=('pkgconf')
source=("https://archive.xfce.org/src/xfce/xfce4-appfinder/4.18/xfce4-appfinder-${pkgver}.tar.bz2")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --sbindir=/usr/bin

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
