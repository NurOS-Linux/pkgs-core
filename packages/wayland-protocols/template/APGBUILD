pkgname=wayland-protocols
pkgver=1.39
pkgrel=1
pkgdesc="Specifications of extended Wayland protocols"
arch=('any')
url="https://wayland.freedesktop.org/"
license=('MIT')
depends=('wayland')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://gitlab.freedesktop.org/wayland/wayland-protocols/-/archive/${pkgver}/wayland-protocols-${pkgver}.tar.bz2")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --buildtype=release \
    -Dtests=false

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
