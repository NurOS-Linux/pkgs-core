pkgname=multipath-tools
pkgver=0.15.1
pkgrel=1
pkgdesc="Device mapper multipathing tools"
arch=('x86_64')
url="https://github.com/opensvc/multipath-tools"
license=('GPL-2.0-only')
depends=(
  'glibc' 'device-mapper' 'libaio' 'json-c' 'userspace-rcu' 'readline'
  'util-linux' 'eudev'
)
makedepends=('pkgconf')
source=("https://github.com/opensvc/multipath-tools/archive/refs/tags/${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make prefix=/usr exec_prefix=/usr etc_prefix=/ bindir=/usr/bin LIB=lib SYSTEMD=
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make prefix=/usr exec_prefix=/usr etc_prefix=/ bindir=/usr/bin LIB=lib SYSTEMD= DESTDIR="${pkgdir}" install
}
