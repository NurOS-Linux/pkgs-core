pkgname=basu
pkgver=0.2.1
pkgrel=1
pkgdesc="sd-bus library extracted from systemd"
arch=('x86_64')
url="https://sr.ht/~emersion/basu"
license=('LGPL-2.1-or-later')
depends=('glibc' 'libcap')
makedepends=('meson' 'ninja' 'pkgconf' 'gperf')
source=("https://git.sr.ht/~emersion/basu/refs/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
