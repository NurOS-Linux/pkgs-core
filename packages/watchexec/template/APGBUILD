pkgname=watchexec
pkgver=2.7.3
pkgrel=1
pkgdesc="Execute commands in response to file modifications"
arch=('x86_64')
url="https://github.com/watchexec/watchexec"
license=('Apache-2.0')
depends=('glibc' 'gcc')
makedepends=('cargo')
source=("https://github.com/watchexec/watchexec/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cargo build --frozen --release -p watchexec-cli
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/watchexec" "${pkgdir}/usr/bin/watchexec"
}
