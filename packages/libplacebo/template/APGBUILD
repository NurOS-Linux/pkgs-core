pkgname=libplacebo
pkgver=6.338.2
pkgrel=1
pkgdesc="Reusable library for GPU-accelerated video/image rendering primitives"
arch=('x86_64')
url="https://github.com/haasn/libplacebo"
license=('LGPL-2.1-or-later')
depends=('glibc')
makedepends=('meson' 'ninja' 'pkgconf' 'python')
source=("https://github.com/haasn/libplacebo/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --buildtype=release \
    -Ddemos=false \
    -Dtests=false \
    -Dvulkan=disabled \
    -Dopengl=disabled \
    -Dshaderc=disabled \
    -Dlcms=disabled

  ninja -C build -v
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
  rm -f "${pkgdir}/usr/share/info/dir"
}
