pkgname=libplacebo
pkgver=6.338.2
pkgrel=1
pkgdesc="Reusable library for GPU-accelerated video/image rendering primitives"
arch=('x86_64')
url="https://github.com/haasn/libplacebo"
license=('LGPL-2.1-or-later')
depends=('glibc')
makedepends=('meson' 'ninja' 'pkgconf' 'python')
source=(
  "https://github.com/haasn/libplacebo/archive/refs/tags/v${pkgver}.tar.gz"
  "jinja-3.1.5.tar.gz::https://github.com/pallets/jinja/archive/refs/tags/3.1.5.tar.gz"
  "markupsafe-3.0.2.tar.gz::https://github.com/pallets/markupsafe/archive/refs/tags/3.0.2.tar.gz"
  "glad-2.0.8.tar.gz::https://github.com/Dav1dde/glad/archive/refs/tags/v2.0.8.tar.gz"
)

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  # Deploy bundled python preprocessor submodules required by glsl_preproc
  rm -rf "${dir}/3rdparty/jinja" "${dir}/3rdparty/markupsafe" "${dir}/3rdparty/glad"
  mkdir -p "${dir}/3rdparty"

  if [ -d "${srcdir}/jinja-3.1.5" ]; then
    cp -r "${srcdir}/jinja-3.1.5" "${dir}/3rdparty/jinja"
  fi
  if [ -d "${srcdir}/markupsafe-3.0.2" ]; then
    cp -r "${srcdir}/markupsafe-3.0.2" "${dir}/3rdparty/markupsafe"
  fi
  if [ -d "${srcdir}/glad-2.0.8" ]; then
    cp -r "${srcdir}/glad-2.0.8" "${dir}/3rdparty/glad"
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --buildtype=release \
    -Ddemos=false \
    -Dtests=false \
    -Dvulkan=disabled \
    -Dopengl=disabled \
    -Dshaderc=disabled \
    -Dlcms=disabled

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
  rm -f "${pkgdir}/usr/share/info/dir"
}
