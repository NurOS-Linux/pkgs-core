pkgname=ranger
pkgver=1.9.4
pkgrel=1
pkgdesc="A VIM-inspired filemanager for the console"
arch=('any')
url="https://ranger.github.io/"
license=('GPL-3.0-or-later')
depends=('python')
makedepends=('python')
source=("https://ranger.github.io/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  python3 setup.py build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  python3 setup.py install --root="${pkgdir}" --prefix=/usr --optimize=1
}
