pkgname=pypi_pathspec
pkgver=1.1.1
pkgrel=1
pkgdesc="Utility library for gitignore style pattern matching of file paths."
arch=('any')
url="https://pypi.org/project/pathspec/"
license=('MPL-2.0')
depends=('python')
makedepends=('python' 'pypi_pip' 'pypi_flit_core')
provides=('pathspec')
source=("https://files.pythonhosted.org/packages/5a/82/42f767fc1c1143d6fd36efb827202a2d997a375e160a71eb2888a925aac1/pathspec-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/pathspec-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

package() {
  cd "${srcdir}/pathspec-${pkgver}"

  python3 -m pip install --no-deps --no-build-isolation --root="${pkgdir}" --prefix=/usr .
}
