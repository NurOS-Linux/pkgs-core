pkgname=bridge-utils
pkgver=1.7.1
pkgrel=1
pkgdesc="Utilities for configuring the Linux Ethernet bridge"
arch=('x86_64')
url="https://wiki.linuxfoundation.org/networking/bridge"
license=('GPL-2.0-or-later')
depends=('glibc')
makedepends=()
source=("https://kernel.org/pub/linux/utils/net/bridge-utils/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  autoconf
  ./configure --prefix=/usr --sbindir=/usr/bin --mandir=/usr/share/man
  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
