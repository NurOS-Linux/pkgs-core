pkgname=libcbor
pkgver=0.14.0
pkgrel=1
pkgdesc="CBOR serialization implementation for C"
arch=('x86_64')
url="https://github.com/PJK/libcbor"
license=('MIT')
depends=('glibc')
makedepends=('cmake' 'ninja')
source=("https://github.com/PJK/libcbor/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DBUILD_SHARED_LIBS=ON \
    -DWITH_TESTS=OFF \
    -DWITH_EXAMPLES=OFF

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
