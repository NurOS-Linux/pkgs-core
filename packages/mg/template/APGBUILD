pkgname=mg
pkgver=4.1
pkgrel=1
pkgdesc="Micro GNU/emacs style editor"
arch=('x86_64')
url="https://github.com/troglobit/mg"
license=('LicenseRef-Public-Domain')
depends=('glibc' 'ncurses')
makedepends=('pkgconf')
source=("https://github.com/troglobit/mg/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
