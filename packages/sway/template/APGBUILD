pkgname=sway
pkgver=1.10
pkgrel=1
pkgdesc="i3-compatible Wayland compositor"
arch=('x86_64')
url="https://swaywm.org/"
license=('MIT')
depends=(
  'glibc' 'wlroots' 'wayland' 'wayland-protocols' 'pcre2' 'json-c'
  'pango' 'cairo' 'libxkbcommon' 'libevdev'
)
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://github.com/swaywm/sway/archive/refs/tags/${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --buildtype=release \
    -Dman-pages=disabled \
    -Dxwayland=disabled \
    -Dtray=disabled

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
  rm -f "${pkgdir}/usr/share/info/dir"
}
