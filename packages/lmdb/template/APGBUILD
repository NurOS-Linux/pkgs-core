pkgname=lmdb
pkgver=0.9.33
pkgrel=1
pkgdesc="Symas Lightning Memory-Mapped Database"
arch=('x86_64')
url="https://symas.com/lmdb/"
license=('OLDAP-2.8')
depends=('glibc')
source=("https://github.com/LMDB/lmdb/archive/refs/tags/LMDB_${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/lmdb-LMDB_${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/lmdb-LMDB_${pkgver}/libraries/liblmdb"

  make prefix=/usr
}

package() {
  cd "${srcdir}/lmdb-LMDB_${pkgver}/libraries/liblmdb"

  install -dm755 "${pkgdir}"/usr/{bin,lib,include,share/man/man1,lib/pkgconfig}
  make prefix=/usr DESTDIR="${pkgdir}" install

  cat << 'EOF' > "${pkgdir}/usr/lib/pkgconfig/lmdb.pc"
prefix=/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: lmdb
Description: Lightning Memory-Mapped Database
Version: 0.9.33
Libs: -L${libdir} -llmdb
Cflags: -I${includedir}
EOF
}
