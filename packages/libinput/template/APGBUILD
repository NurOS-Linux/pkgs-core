pkgname=libinput
pkgver=1.32.0
pkgrel=1
pkgdesc="Library to handle input devices in Wayland compositors and X.org"
arch=('x86_64')
url="https://www.freedesktop.org/wiki/Software/libinput/"
license=('MIT')
depends=('glibc' 'eudev' 'libevdev' 'mtdev' 'libwacom')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://gitlab.freedesktop.org/libinput/libinput/-/archive/${pkgver}/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release \
    -Dtests=false \
    -Dinstall-tests=false \
    -Ddebug-gui=false \
    -Ddocumentation=false \
    -Dlibwacom=true \
    -Dlua-plugins=disabled \
    -Dudev-dir=/usr/lib/udev

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
