pkgname=pipes-sh
pkgver=1.3.0
pkgrel=1
pkgdesc="Animated pipes terminal screensaver"
arch=('any')
url="https://github.com/pipeseroni/pipes.sh"
license=('MIT')
depends=('bash')
makedepends=()
source=("https://github.com/pipeseroni/pipes.sh/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/pipes.sh-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

package() {
  cd "${srcdir}/pipes.sh-${pkgver}"

  make PREFIX=/usr DESTDIR="${pkgdir}" install
}
