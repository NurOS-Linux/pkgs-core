pkgname=exiftool
pkgver=13.59
pkgrel=1
pkgdesc="Read, write and edit meta information in files"
arch=('x86_64')
url="https://exiftool.org/"
license=('Artistic-1.0-Perl')
depends=('perl')
makedepends=('perl')
source=("https://github.com/exiftool/exiftool/archive/refs/tags/${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  perl Makefile.PL INSTALLDIRS=vendor
  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
