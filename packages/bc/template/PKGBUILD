# Maintainer: AnmiTaliDev <anmitalidev@nuros.org>

pkgname=bc
pkgver=1.08.1
pkgrel=1
pkgdesc="An arbitrary precision numeric processing language"
arch=('x86_64')
url="https://www.gnu.org/software/bc/"
license=('GPL-3.0-or-later')
depends=('glibc' 'readline')
source=("https://ftp.gnu.org/gnu/bc/bc-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --with-readline \
    --mandir=/usr/share/man \
    --infodir=/usr/share/info

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
