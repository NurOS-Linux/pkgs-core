pkgname=wayland-utils
pkgver=1.3.0
pkgrel=1
pkgdesc="Utilities for Wayland such as wayland-info"
arch=('x86_64')
url="https://gitlab.freedesktop.org/wayland/wayland-utils"
license=('MIT')
depends=('glibc' 'wayland' 'libdrm')
makedepends=('meson' 'ninja' 'pkgconf' 'wayland-protocols')
source=("https://gitlab.freedesktop.org/wayland/wayland-utils/-/archive/${pkgver}/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
