pkgname=rr
pkgver=5.9.0
pkgrel=1
pkgdesc="Record and Replay Framework for C/C++"
arch=('x86_64')
url="https://rr-project.org/"
license=('MIT')
depends=('glibc' 'gcc' 'zlib' 'python')
makedepends=('cmake' 'ninja' 'pkgconf')
source=("https://github.com/rr-debugger/rr/archive/refs/tags/${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTS=OFF
  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  DESTDIR="${pkgdir}" ninja -C build install
}
