pkgname=yasm
pkgver=1.3.0
pkgrel=1
pkgdesc="A complete rewrite of the NASM assembler for the x86 series processors"
arch=('x86_64')
url="https://yasm.tortall.net/"
license=('BSD-2-Clause' 'BSD-3-Clause')
depends=('glibc')
makedepends=()
source=("https://www.tortall.net/projects/yasm/releases/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
