pkgname=ripgrep
pkgver=15.2.0
pkgrel=1
pkgdesc="A line-oriented search tool that recursively searches your current directory for a regex pattern"
arch=('x86_64')
url="https://github.com/BurntSushi/ripgrep"
license=('Unlicense' 'MIT')
depends=('glibc' 'gcc')
makedepends=('cargo')
source=("https://github.com/BurntSushi/ripgrep/archive/refs/tags/${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cargo build --frozen --release
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/rg" "${pkgdir}/usr/bin/rg"
}
