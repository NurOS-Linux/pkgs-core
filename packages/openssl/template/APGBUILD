pkgname=openssl
pkgver=3.6.4
pkgrel=1
pkgdesc="General-purpose cryptography and secure communication toolkit"
arch=('x86_64')
url="https://www.openssl.org/"
license=('Apache-2.0')
depends=('glibc')
source=("https://github.com/openssl/openssl/releases/download/openssl-${pkgver}/openssl-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./Configure \
      --prefix=/usr \
      --openssldir=/etc/ssl \
      --libdir=lib \
      shared \
      linux-x86_64

  make -j"$(nproc)"
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" MANDIR=/usr/share/man MANSUFFIX=ssl install_sw
}
