pkgname=chrony
pkgver=4.9
pkgrel=1
pkgdesc="Versatile implementation of the Network Time Protocol (NTP)"
arch=('x86_64')
url="https://chrony-project.org/"
license=('GPL-2.0-only')
depends=('glibc' 'libcap')
source=("https://chrony-project.org/releases/chrony-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc/chrony \
    --localstatedir=/var \
    --without-tomcrypt

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  install -dm755 "${pkgdir}/etc/chrony"
  install -m644 examples/chrony.conf.example "${pkgdir}/etc/chrony/chrony.conf"
}
