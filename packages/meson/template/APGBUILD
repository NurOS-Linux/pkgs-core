pkgname=meson
pkgver=1.12.0
pkgrel=1
pkgdesc="High productivity build system"
arch=('any')
url="https://mesonbuild.com/"
license=('Apache-2.0')
depends=('python' 'ninja')
source=("https://github.com/mesonbuild/meson/releases/download/${pkgver}/meson-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  :
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  local pydir="${pkgdir}/usr/lib/python3.14/site-packages"
  mkdir -p "${pydir}" "${pkgdir}/usr/bin"

  cp -a mesonbuild "${pydir}/"
  install -m755 meson.py "${pkgdir}/usr/bin/meson"

  install -d "${pkgdir}/usr/share/bash-completion/completions"
  install -m644 data/shell-completions/bash/meson "${pkgdir}/usr/share/bash-completion/completions/meson"

  install -d "${pkgdir}/usr/share/zsh/site-functions"
  install -m644 data/shell-completions/zsh/_meson "${pkgdir}/usr/share/zsh/site-functions/_meson"
}
