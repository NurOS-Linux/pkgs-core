pkgname=tailscale
pkgver=1.102.4
pkgrel=1
pkgdesc="Mesh VPN based on WireGuard"
arch=('x86_64')
url="https://tailscale.com/"
license=('BSD-3-Clause')
depends=('glibc' 'iptables' 'iproute2')
makedepends=('go')
source=("https://github.com/tailscale/tailscale/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  export CGO_ENABLED=0
  go build -trimpath -ldflags="-s -w -X tailscale.com/version.longStamp=${pkgver} -X tailscale.com/version.shortStamp=${pkgver}" -o tailscale ./cmd/tailscale
  go build -trimpath -ldflags="-s -w -X tailscale.com/version.longStamp=${pkgver} -X tailscale.com/version.shortStamp=${pkgver}" -o tailscaled ./cmd/tailscaled
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 tailscale "${pkgdir}/usr/bin/tailscale"
  install -Dm755 tailscaled "${pkgdir}/usr/bin/tailscaled"
}
