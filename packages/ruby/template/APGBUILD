pkgname=ruby
pkgver=4.0.7
pkgrel=1
pkgdesc="An open source, object-oriented programming language"
arch=('x86_64')
url="https://www.ruby-lang.org/"
license=('Ruby' 'BSD-2-Clause')
depends=('glibc' 'openssl' 'readline' 'zlib' 'libffi' 'gdbm')
makedepends=('pkgconf')
source=("https://cache.ruby-lang.org/pub/ruby/${pkgver%.*}/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --enable-shared \
    --disable-install-doc

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
