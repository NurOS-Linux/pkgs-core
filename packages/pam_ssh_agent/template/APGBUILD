pkgname=pam_ssh_agent
pkgver=0.3.0
pkgrel=1
pkgdesc="PAM module for authentication with ssh-agent"
arch=('x86_64')
url="https://github.com/flatcap/pam-ssh-agent"
license=('GPL-2.0-only')
depends=('glibc' 'linux-pam')
makedepends=('cargo')
source=("https://github.com/flatcap/pam-ssh-agent/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/pam-ssh-agent-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/pam-ssh-agent-${pkgver}"
  cargo build --frozen --release
}

package() {
  cd "${srcdir}/pam-ssh-agent-${pkgver}"
  install -Dm755 "target/release/libpam_ssh_agent.so" "${pkgdir}/usr/lib/security/pam_ssh_agent.so"
}
