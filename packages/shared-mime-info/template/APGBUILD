pkgname=shared-mime-info
pkgver=2.4
pkgrel=1
pkgdesc="Freedesktop.org Shared MIME Info database specification and database"
arch=('x86_64')
url="https://gitlab.freedesktop.org/xdg/shared-mime-info"
license=('GPL-2.0-or-later')
depends=('glibc' 'glib' 'libxml2')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://gitlab.freedesktop.org/xdg/shared-mime-info/-/archive/${pkgver}/shared-mime-info-${pkgver}.tar.bz2")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --buildtype=release \
    -Dbuild-tests=false \
    -Dupdate-mimedb=false

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
  rm -f "${pkgdir}/usr/share/info/dir"
}
