pkgname=jsoncpp
pkgver=1.9.8
pkgrel=1
pkgdesc="C++ library for interacting with JSON"
arch=('x86_64')
url="https://github.com/open-source-parsers/jsoncpp"
license=('MIT')
depends=('glibc' 'gcc')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://github.com/open-source-parsers/jsoncpp/archive/refs/tags/${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release \
    -Dtests=false

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
