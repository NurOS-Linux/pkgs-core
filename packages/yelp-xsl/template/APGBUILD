pkgname=yelp-xsl
pkgver=49.0
pkgrel=1
pkgdesc="XSL stylesheets for Yelp and related documentation tools"
arch=('x86_64')
url="https://gitlab.gnome.org/GNOME/yelp-xsl"
license=('LGPL-2.1-or-later' 'GPL-2.0-or-later')
depends=()
makedepends=('meson' 'ninja' 'pkgconf' 'itstool' 'libxslt')
source=("https://download.gnome.org/sources/yelp-xsl/${pkgver%.*}/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
