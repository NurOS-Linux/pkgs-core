pkgname=libblockdev
pkgver=3.5.0
pkgrel=1
pkgdesc="Library for manipulating block devices"
arch=('x86_64')
url="https://github.com/storaged-project/libblockdev"
license=('LGPL-2.1-or-later')
depends=(
  'glibc' 'glib' 'libbytesize' 'libatasmart' 'cryptsetup' 'device-mapper'
  'util-linux' 'keyutils' 'libnvme' 'eudev' 'kmod'
)
makedepends=('pkgconf' 'gettext')
source=("https://github.com/storaged-project/libblockdev/releases/download/${pkgver}/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --without-python3 \
    --enable-introspection=no \
    --without-lvm \
    --without-lvm_dbus \
    --without-btrfs \
    --without-dm \
    --without-mpath \
    --without-nvdimm \
    --without-tools \
    --without-escrow \
    --without-s390 \
    --without-smartmontools

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
