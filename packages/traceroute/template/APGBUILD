pkgname=traceroute
pkgver=2.1.6
pkgrel=1
pkgdesc="Tracks the route packets take to a network host"
arch=('x86_64')
url="https://sourceforge.net/projects/traceroute/"
license=('GPL-2.0-or-later')
depends=('glibc')
makedepends=()
source=("https://downloads.sourceforge.net/project/traceroute/traceroute/${pkgname}-${pkgver}/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make prefix=/usr sbindir=/usr/bin DESTDIR="${pkgdir}" install
}
