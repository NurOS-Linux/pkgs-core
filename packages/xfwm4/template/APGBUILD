pkgname=xfwm4
pkgver=4.18.0
pkgrel=1
pkgdesc="Window manager of the Xfce project"
arch=('x86_64')
url="https://docs.xfce.org/xfce/xfwm4/start"
license=('GPL-2.0-or-later')
depends=(
  'glibc' 'glib' 'gtk3' 'libxfce4util' 'libxfce4ui' 'xfconf'
  'libwnck' 'libx11' 'libxext' 'libxrandr' 'libxrender' 'libxcomposite'
  'libxdamage' 'libxfixes' 'libepoxy'
)
makedepends=('pkgconf')
source=("https://archive.xfce.org/src/xfce/xfwm4/4.18/xfwm4-${pkgver}.tar.bz2")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --sbindir=/usr/bin \
    --enable-compositor \
    --enable-epoxy

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
