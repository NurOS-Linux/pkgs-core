post_install() {
  if [ ! -e /etc/xml/catalog ]; then
    /usr/bin/xmlcatalog --noout --create /etc/xml/catalog
  fi
  /usr/bin/xmlcatalog --noout --add "delegatePublic" \
    "-//OASIS//DTD DocBook XML" "file:///etc/xml/docbook-xml" /etc/xml/catalog
  /usr/bin/xmlcatalog --noout --add "delegateSystem" \
    "http://www.oasis-open.org/docbook/xml/" "file:///etc/xml/docbook-xml" /etc/xml/catalog
  /usr/bin/xmlcatalog --noout --add "delegateURI" \
    "http://www.oasis-open.org/docbook/xml/" "file:///etc/xml/docbook-xml" /etc/xml/catalog
  /usr/bin/xmlcatalog --noout --add "delegateSystem" \
    "http://docbook.org/xml/" "file:///etc/xml/docbook-xml" /etc/xml/catalog
  /usr/bin/xmlcatalog --noout --add "delegateURI" \
    "http://docbook.org/xml/" "file:///etc/xml/docbook-xml" /etc/xml/catalog
}

post_upgrade() {
  post_install
}

pre_remove() {
  /usr/bin/xmlcatalog --noout --del "file:///etc/xml/docbook-xml" /etc/xml/catalog
}
