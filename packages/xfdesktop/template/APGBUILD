pkgname=xfdesktop
pkgver=4.18.1
pkgrel=1
pkgdesc="Desktop manager for the Xfce desktop environment"
arch=('x86_64')
url="https://docs.xfce.org/xfce/xfdesktop/start"
license=('GPL-2.0-or-later')
depends=(
  'glibc' 'glib' 'gtk3' 'libxfce4util' 'libxfce4ui' 'xfconf'
  'garcon' 'exo' 'thunar' 'libwnck' 'cairo'
)
makedepends=('pkgconf')
source=("https://archive.xfce.org/src/xfce/xfdesktop/4.18/xfdesktop-${pkgver}.tar.bz2")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --sbindir=/usr/bin \
    --enable-file-icons \
    --enable-desktop-icons

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
