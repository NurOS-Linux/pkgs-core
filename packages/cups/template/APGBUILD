pkgname=cups
pkgver=2.4.19
pkgrel=1
pkgdesc="The CUPS Printing System"
arch=('x86_64')
url="https://openprinting.github.io/cups/"
license=('Apache-2.0 WITH LLVM-exception')
depends=('glibc' 'zlib' 'libpng' 'libjpeg-turbo' 'libtiff' 'openssl' 'dbus')
makedepends=('pkgconf')
source=("https://github.com/OpenPrinting/cups/releases/download/v${pkgver}/cups-${pkgver}-source.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --with-components=all \
    --enable-shared \
    --disable-systemd

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make BUILDROOT="${pkgdir}" install
}
