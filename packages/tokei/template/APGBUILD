pkgname=tokei
pkgver=15.0.0
pkgrel=1
pkgdesc="Count lines of code quickly"
arch=('x86_64')
url="https://github.com/XAMPPRocky/tokei"
license=('MIT')
depends=('glibc' 'gcc')
makedepends=('cargo')
source=("https://github.com/XAMPPRocky/tokei/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cargo build --frozen --release
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/tokei" "${pkgdir}/usr/bin/tokei"
}
