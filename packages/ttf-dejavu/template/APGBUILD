pkgname=ttf-dejavu
pkgver=2.37
pkgrel=1
pkgdesc="Font family based on the Vera Fonts with wide Unicode coverage"
arch=('any')
url="https://dejavu-fonts.github.io/"
license=('custom')
depends=('fontconfig')
source=("https://downloads.sourceforge.net/project/dejavu/dejavu/${pkgver}/dejavu-fonts-ttf-${pkgver}.tar.bz2")

prepare() {
  local dir="${srcdir}/dejavu-fonts-ttf-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  :
}

package() {
  cd "${srcdir}/dejavu-fonts-ttf-${pkgver}"

  install -dm755 "${pkgdir}/usr/share/fonts/TTF"
  install -m644 ttf/*.ttf "${pkgdir}/usr/share/fonts/TTF/"

  install -dm755 "${pkgdir}/etc/fonts/conf.d"
  install -dm755 "${pkgdir}/usr/share/fontconfig/conf.avail"
  install -m644 fontconfig/*.conf "${pkgdir}/usr/share/fontconfig/conf.avail/"

  # Enable standard alias configurations
  for f in fontconfig/*.conf; do
    base="$(basename "$f")"
    ln -sf "/usr/share/fontconfig/conf.avail/${base}" "${pkgdir}/etc/fonts/conf.d/${base}"
  done

  rm -f "${pkgdir}/usr/share/info/dir"
}
