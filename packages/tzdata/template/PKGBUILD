# Maintainer: AnmiTaliDev <anmitalidev@nuros.org>

pkgname=tzdata
pkgver=2026c
pkgrel=1
pkgdesc="Sources for time zone and daylight saving time data"
arch=('x86_64')
url="https://www.iana.org/time-zones"
license=('BSD-3-Clause')
depends=()
source=(
  "https://data.iana.org/time-zones/releases/tzcode${pkgver}.tar.gz"
  "https://data.iana.org/time-zones/releases/tzdata${pkgver}.tar.gz"
)

_timezones=(
  'africa'
  'antarctica'
  'asia'
  'australasia'
  'europe'
  'northamerica'
  'southamerica'
  'etcetera'
  'backward'
  'factory'
)

prepare() {
  cd "${srcdir}"
  sed -i "s:sbin:bin:g" Makefile
}

build() {
  cd "${srcdir}"
  make
}

package() {
  cd "${srcdir}"

  make DESTDIR="${pkgdir}" install

  ./zic -b fat -d "${pkgdir}/usr/share/zoneinfo" ${_timezones[@]}
  ./zic -b fat -d "${pkgdir}/usr/share/zoneinfo/posix" ${_timezones[@]}
  ./zic -b fat -d "${pkgdir}/usr/share/zoneinfo/right" -L leapseconds ${_timezones[@]}
  ./zic -b fat -d "${pkgdir}/usr/share/zoneinfo" -p America/New_York

  install -m644 -t "${pkgdir}/usr/share/zoneinfo" iso3166.tab leap-seconds.list zone1970.tab zone.tab SECURITY

  rm -f "${pkgdir}/etc/localtime"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
