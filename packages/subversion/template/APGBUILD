pkgname=subversion
pkgver=1.14.5
pkgrel=1
pkgdesc="A Modern Concurrent Version Control System"
arch=('x86_64')
url="https://subversion.apache.org/"
license=('Apache-2.0')
depends=('glibc' 'apr' 'apr-util' 'zlib' 'sqlite' 'expat')
makedepends=('pkgconf')
provides=('svn')
source=("https://archive.apache.org/dist/subversion/${pkgname}-${pkgver}.tar.bz2")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  ./configure --prefix=/usr --sysconfdir=/etc --without-berkeley-db --without-apxs
  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
