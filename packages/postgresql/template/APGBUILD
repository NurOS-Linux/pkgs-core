pkgname=postgresql
pkgver=18.6
pkgrel=1
pkgdesc="Sophisticated object-relational DBMS"
arch=('x86_64')
url="https://www.postgresql.org/"
license=('PostgreSQL')
depends=('glibc' 'openssl' 'zlib' 'readline' 'libxml2' 'icu')
makedepends=('pkgconf')
source=("https://ftp.postgresql.org/pub/source/v${pkgver}/${pkgname}-${pkgver}.tar.bz2")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --mandir=/usr/share/man \
    --with-openssl \
    --with-libxml \
    --with-icu \
    --without-systemd

  make -j"$(nproc)"
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
