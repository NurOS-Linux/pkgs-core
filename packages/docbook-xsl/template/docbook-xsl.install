post_install() {
  if [ ! -e /etc/xml/catalog ]; then
    /usr/bin/xmlcatalog --noout --create /etc/xml/catalog
  fi
  /usr/bin/xmlcatalog --noout --add "delegateSystem" \
    "http://docbook.sourceforge.net/release/xsl/" "file:///etc/xml/docbook-xsl" /etc/xml/catalog
  /usr/bin/xmlcatalog --noout --add "delegateURI" \
    "http://docbook.sourceforge.net/release/xsl/" "file:///etc/xml/docbook-xsl" /etc/xml/catalog
  /usr/bin/xmlcatalog --noout --add "delegateSystem" \
    "http://cdn.docbook.org/release/xsl/" "file:///etc/xml/docbook-xsl" /etc/xml/catalog
  /usr/bin/xmlcatalog --noout --add "delegateURI" \
    "http://cdn.docbook.org/release/xsl/" "file:///etc/xml/docbook-xsl" /etc/xml/catalog
}

post_upgrade() {
  post_install
}

pre_remove() {
  /usr/bin/xmlcatalog --noout --del "file:///etc/xml/docbook-xsl" /etc/xml/catalog
}
