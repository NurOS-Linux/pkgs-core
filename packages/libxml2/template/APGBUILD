pkgname=libxml2
pkgver=2.13.5
pkgrel=1
pkgdesc="XML parsing library, version 2"
arch=('x86_64')
url="https://gitlab.gnome.org/GNOME/libxml2"
license=('MIT')
depends=('glibc' 'zlib' 'xz' 'python')
makedepends=('pkgconf')
source=("https://download.gnome.org/sources/libxml2/2.13/libxml2-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --with-python \
    --disable-static

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
