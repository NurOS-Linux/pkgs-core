pkgname=swaybg
pkgver=1.2.1
pkgrel=1
pkgdesc="Wallpaper utility for Wayland compositors"
arch=('x86_64')
url="https://github.com/swaywm/swaybg"
license=('MIT')
depends=('glibc' 'wayland' 'wayland-protocols' 'cairo' 'gdk-pixbuf')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://github.com/swaywm/swaybg/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --buildtype=release \
    -Dman-pages=disabled

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
  rm -f "${pkgdir}/usr/share/info/dir"
}
