pkgname=nasm
pkgver=2.16.03
pkgrel=1
pkgdesc="An 80x86 and x86-64 assembler designed for portability and modularity"
arch=('x86_64')
url="https://www.nasm.us/"
license=('BSD-2-Clause')
depends=('glibc')
source=("https://www.nasm.us/pub/nasm/releasebuilds/${pkgver}/nasm-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr

  make -j"$(nproc)"
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
