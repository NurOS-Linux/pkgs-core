pkgname=rclone
pkgver=1.75.1
pkgrel=1
pkgdesc="Command line program to sync files and directories to cloud storage"
arch=('x86_64')
url="https://rclone.org/"
license=('MIT')
depends=('glibc')
makedepends=('go')
source=("https://github.com/rclone/rclone/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  export CGO_ENABLED=0
  go build -trimpath -ldflags="-s -w -X github.com/rclone/rclone/fs.Version=v${pkgver}" -o rclone
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 rclone "${pkgdir}/usr/bin/rclone"
}
