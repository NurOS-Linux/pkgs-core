pkgname=xsel
pkgver=1.2.1
pkgrel=1
pkgdesc="Command line tool to access X clipboard and selection buffers"
arch=('x86_64')
url="https://github.com/kfish/xsel"
license=('HPND-sell-variant')
depends=('glibc' 'libx11')
makedepends=('autoconf' 'automake' 'pkgconf')
source=("https://github.com/kfish/xsel/archive/refs/tags/${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  autoreconf -fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
