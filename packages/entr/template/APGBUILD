pkgname=entr
pkgver=5.8
pkgrel=1
pkgdesc="Run arbitrary commands when files change"
arch=('x86_64')
url="https://eradman.com/entrproject/"
license=('ISC')
depends=('glibc')
makedepends=()
source=("https://eradman.com/entrproject/code/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure
  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make PREFIX=/usr DESTDIR="${pkgdir}" install
}
