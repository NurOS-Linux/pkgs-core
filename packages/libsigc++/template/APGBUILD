pkgname=libsigc++
pkgver=2.12.1
pkgrel=1
pkgdesc="Type-safe callback system for standard C++"
arch=('x86_64')
url="https://gitlab.gnome.org/GNOME/libsigc++"
license=('LGPL-3.0-or-later')
depends=('glibc' 'gcc')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://download.gnome.org/sources/libsigc++/${pkgver%.*}/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release \
    -Dbuild-documentation=false \
    -Dbuild-examples=false \
    -Dbuild-tests=false

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
