pkgname=pypi_setuptools_scm
pkgver=10.3.4
pkgrel=1
pkgdesc="the blessed package to manage your versions by scm tags"
arch=('any')
url="https://pypi.org/project/setuptools-scm/"
license=('MIT')
depends=('python' 'pypi_vcs_versioning' 'pypi_packaging' 'pypi_setuptools')
makedepends=('python' 'pypi_pip' 'pypi_setuptools' 'pypi_vcs_versioning')
provides=('setuptools-scm')
source=("https://files.pythonhosted.org/packages/85/d8/fc143f88819ccf10ba2388ba86732ee2de193e578234e25a783f6cc14bf7/setuptools_scm-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/setuptools_scm-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

package() {
  cd "${srcdir}/setuptools_scm-${pkgver}"

  python3 -m pip install --no-deps --no-build-isolation --root="${pkgdir}" --prefix=/usr .
}
