pkgname=wlogout
pkgver=1.2.2
pkgrel=1
pkgdesc="Logout menu for Wayland"
arch=('x86_64')
url="https://github.com/ArtsyMacaw/wlogout"
license=('MIT')
depends=('glibc' 'gtk3' 'gtk-layer-shell' 'wayland')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://github.com/ArtsyMacaw/wlogout/archive/refs/tags/${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
