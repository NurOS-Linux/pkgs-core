pkgname=compiler-rt
pkgver=22.1.8
pkgrel=1
pkgdesc="Compiler runtime libraries for Clang and LLVM"
arch=('x86_64')
url="https://compiler-rt.llvm.org/"
license=('Apache-2.0 WITH LLVM-exception')
depends=('glibc' 'gcc')
makedepends=('llvm' 'clang' 'cmake' 'ninja' 'python')
source=("https://github.com/llvm/llvm-project/releases/download/llvmorg-${pkgver}/llvm-project-${pkgver}.src.tar.xz")

prepare() {
  local dir="${srcdir}/llvm-project-${pkgver}.src"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/llvm-project-${pkgver}.src"

  cmake -B build -S compiler-rt -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCOMPILER_RT_INSTALL_PATH="/usr/lib/clang/${pkgver%%.*}" \
    -DCOMPILER_RT_INCLUDE_TESTS=OFF \
    -DLLVM_INCLUDE_TESTS=OFF

  ninja -C build -j"$(nproc)"
}

package() {
  cd "${srcdir}/llvm-project-${pkgver}.src"

  DESTDIR="${pkgdir}" ninja -C build install
}
