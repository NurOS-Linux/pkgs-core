pkgname=slurp
pkgver=1.5.0
pkgrel=1
pkgdesc="Select a region in a Wayland compositor and print it to stdout"
arch=('x86_64')
url="https://wayland.emersion.fr/slurp/"
license=('MIT')
depends=('glibc' 'wayland' 'wayland-protocols' 'cairo' 'libxkbcommon')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://github.com/emersion/slurp/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --buildtype=release \
    -Dman-pages=disabled

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
  rm -f "${pkgdir}/usr/share/info/dir"
}
