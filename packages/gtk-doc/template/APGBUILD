pkgname=gtk-doc
pkgver=1.36.1
pkgrel=1
pkgdesc="Documentation tool for public library APIs"
arch=('x86_64')
url="https://gitlab.gnome.org/GNOME/gtk-doc"
license=('GPL-2.0-or-later' 'GFDL-1.1-or-later')
depends=('python' 'libxml2' 'libxslt' 'docbook-xml' 'docbook-xsl')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://download.gnome.org/sources/gtk-doc/${pkgver%.*}/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release \
    -Dtests=false \
    -Dyelp_manual=false

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
