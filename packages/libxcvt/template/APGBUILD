pkgname=libxcvt
pkgver=0.1.3
pkgrel=1
pkgdesc="Library providing a standalone version of the X server VESA CVT standard timing modelines generator"
arch=('x86_64')
url="https://xorg.freedesktop.org/"
license=('MIT')
depends=('glibc')
makedepends=('meson' 'ninja')
source=("https://xorg.freedesktop.org/releases/individual/lib/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --buildtype=release

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
  rm -f "${pkgdir}/usr/share/info/dir"
}
