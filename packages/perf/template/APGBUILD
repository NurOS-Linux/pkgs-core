pkgname=perf
pkgver=6.12.0
pkgrel=1
pkgdesc="Linux performance auditing tool"
arch=('x86_64')
url="https://perf.wiki.kernel.org/"
license=('GPL-2.0-only')
depends=('glibc' 'elfutils' 'binutils' 'zlib' 'zstd' 'xz' 'slang')
makedepends=('bison' 'flex' 'asciidoc')
source=("https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/linux-${pkgver}/tools/perf"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/linux-${pkgver}/tools/perf"
  make -f Makefile.perf prefix=/usr WERROR=0 NO_LIBPYTHON=1
}

package() {
  cd "${srcdir}/linux-${pkgver}/tools/perf"
  make -f Makefile.perf prefix=/usr DESTDIR="${pkgdir}" NO_LIBPYTHON=1 install
}
