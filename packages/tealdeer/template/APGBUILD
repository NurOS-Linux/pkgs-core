pkgname=tealdeer
pkgver=1.9.0
pkgrel=1
pkgdesc="A very fast, compliant implementation of tldr in Rust"
arch=('x86_64')
url="https://github.com/tealdeer-rs/tealdeer"
license=('MIT' 'Apache-2.0')
depends=('glibc' 'gcc')
makedepends=('cargo')
source=("https://github.com/tealdeer-rs/tealdeer/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cargo build --frozen --release
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/tldr" "${pkgdir}/usr/bin/tldr"
}
