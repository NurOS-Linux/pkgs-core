pkgname=texlab
pkgver=5.26.0
pkgrel=1
pkgdesc="Language server for LaTeX"
arch=('x86_64')
url="https://github.com/latex-lsp/texlab"
license=('GPL-3.0-only')
depends=('glibc' 'gcc')
makedepends=('cargo')
source=("https://github.com/latex-lsp/texlab/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cargo build --frozen --release
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/texlab" "${pkgdir}/usr/bin/texlab"
}
