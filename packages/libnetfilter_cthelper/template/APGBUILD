pkgname=libnetfilter_cthelper
pkgver=1.0.1
pkgrel=1
pkgdesc="Library providing an API to the netfilter user-space connection tracking helpers"
arch=('x86_64')
url="https://netfilter.org/projects/libnetfilter_cthelper/"
license=('GPL-2.0-or-later')
depends=('glibc' 'libmnl')
makedepends=('pkgconf')
source=("https://www.netfilter.org/projects/libnetfilter_cthelper/files/${pkgname}-${pkgver}.tar.bz2")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --disable-static

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
