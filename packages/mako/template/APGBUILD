pkgname=mako
pkgver=1.9.0
pkgrel=1
pkgdesc="A lightweight notification daemon for Wayland compositors"
arch=('x86_64')
url="https://wayland.emersion.fr/mako/"
license=('MIT')
depends=('glibc' 'wayland' 'wayland-protocols' 'cairo' 'pango' 'basu')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://github.com/emersion/mako/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --buildtype=release \
    -Dman-pages=disabled \
    -Dsd-bus-provider=basu

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
  rm -f "${pkgdir}/usr/share/info/dir"
}
