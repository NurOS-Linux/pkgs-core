pkgname=bash
pkgver=5.3
pkgrel=2
pkgdesc="The GNU Bourne Again shell"
arch=('x86_64')
url="https://www.gnu.org/software/bash/"
license=('GPL-3.0-or-later')
depends=('glibc')
provides=('sh')
source=("https://ftp.gnu.org/gnu/bash/bash-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
      --prefix=/usr \
      --without-bash-malloc \
      --docdir="/usr/share/doc/${pkgname}"

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" AM_UPDATE_INFO_DIR=no install

  ln -sf bash "${pkgdir}/usr/bin/sh"
}
