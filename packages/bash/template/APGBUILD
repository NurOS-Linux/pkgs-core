pkgname=bash
pkgver=5.3
pkgrel=3
pkgdesc="The GNU Bourne Again shell"
arch=('x86_64')
url="https://www.gnu.org/software/bash/"
license=('GPL-3.0-or-later')
depends=('glibc')
provides=('sh')
source=("https://ftp.gnu.org/gnu/bash/bash-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
      --prefix=/usr \
      --without-bash-malloc \
      --docdir="/usr/share/doc/${pkgname}"

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  # Mask install-info during packaging so doc/Makefile.in skips updating /usr/share/info/dir
  local fakebin="${srcdir}/fakebin"
  mkdir -p "${fakebin}"
  ln -sf /bin/false "${fakebin}/install-info"

  PATH="${fakebin}:${PATH}" make DESTDIR="${pkgdir}" install

  ln -sf bash "${pkgdir}/usr/bin/sh"
}
