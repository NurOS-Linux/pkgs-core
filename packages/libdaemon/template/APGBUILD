pkgname=libdaemon
pkgver=0.14
pkgrel=1
pkgdesc="Lightweight C library for writing UNIX daemons"
arch=('x86_64')
url="http://0pointer.de/lennart/projects/libdaemon/"
license=('LGPL-2.1-or-later')
depends=('glibc')
makedepends=('pkgconf')
source=("http://0pointer.de/lennart/projects/libdaemon/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --localstatedir=/var \
    --disable-static \
    --disable-lynx

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
