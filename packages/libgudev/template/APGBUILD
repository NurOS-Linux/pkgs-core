pkgname=libgudev
pkgver=238
pkgrel=1
pkgdesc="GObject bindings for libudev"
arch=('x86_64')
url="https://wiki.gnome.org/Projects/libgudev"
license=('LGPL-2.1-or-later')
depends=('glibc' 'glib' 'eudev')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://download.gnome.org/sources/libgudev/${pkgver}/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release \
    -Dtests=disabled \
    -Dintrospection=disabled \
    -Dvapi=disabled \
    -Dgtk_doc=false

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
