pkgname=gsettings-desktop-schemas
pkgver=51.0
pkgrel=1
pkgdesc="Collection of GSettings schemas for desktop components"
arch=('x86_64')
url="https://gitlab.gnome.org/GNOME/gsettings-desktop-schemas"
license=('LGPL-2.1-or-later')
depends=('glib')
makedepends=('meson' 'ninja' 'pkgconf' 'gettext')
source=("https://download.gnome.org/sources/gsettings-desktop-schemas/${pkgver%.*}/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release \
    -Dintrospection=false

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
