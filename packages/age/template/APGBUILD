pkgname=age
pkgver=1.3.2
pkgrel=1
pkgdesc="Simple, modern and secure file encryption tool"
arch=('x86_64')
url="https://age-encryption.org/"
license=('BSD-3-Clause')
depends=('glibc')
makedepends=('go')
source=("https://github.com/FiloSottile/age/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  export CGO_ENABLED=0
  go build -trimpath -ldflags="-s -w -X main.Version=v${pkgver}" -o age ./cmd/age
  go build -trimpath -ldflags="-s -w -X main.Version=v${pkgver}" -o age-keygen ./cmd/age-keygen
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 age "${pkgdir}/usr/bin/age"
  install -Dm755 age-keygen "${pkgdir}/usr/bin/age-keygen"
}
