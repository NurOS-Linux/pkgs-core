pkgname=crun
pkgver=1.30.1
pkgrel=1
pkgdesc="Fast and lightweight OCI container runtime"
arch=('x86_64')
url="https://github.com/containers/crun"
license=('GPL-2.0-or-later')
depends=('glibc' 'libcap' 'libseccomp' 'yajl')
makedepends=('pkgconf' 'python')
source=("https://github.com/containers/crun/releases/download/${pkgver}/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --disable-systemd

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
