pkgname=gc
pkgver=8.2.12
pkgrel=1
pkgdesc="Boehm-Demers-Weiser conservative garbage collector"
arch=('x86_64')
url="https://www.hboehm.info/gc/"
license=('MIT')
depends=('glibc' 'gcc')
makedepends=('pkgconf')
source=("https://github.com/ivmai/bdwgc/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --disable-static \
    --enable-cplusplus

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
