pkgname=libxi
pkgver=1.8.2
pkgrel=1
pkgdesc="X11 Input extension library"
arch=('x86_64')
url="https://xorg.freedesktop.org/"
license=('MIT')
depends=('glibc' 'libx11' 'libxext' 'libxfixes')
makedepends=('pkgconf' 'xorgproto' 'util-macros')
source=("https://xorg.freedesktop.org/releases/individual/lib/libXi-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/libXi-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/libXi-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --disable-specs \
    --disable-static

  make -j"$(nproc)"
}

package() {
  cd "${srcdir}/libXi-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
