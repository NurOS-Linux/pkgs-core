pkgname=yq
pkgver=4.53.6
pkgrel=1
pkgdesc="Command line YAML, JSON and XML processor"
arch=('x86_64')
url="https://github.com/mikefarah/yq"
license=('MIT')
depends=('glibc')
makedepends=('go')
source=("https://github.com/mikefarah/yq/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  export CGO_ENABLED=0
  go build -trimpath -ldflags="-s -w" -o yq
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 yq "${pkgdir}/usr/bin/yq"
}
