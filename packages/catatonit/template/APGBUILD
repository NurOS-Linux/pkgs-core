pkgname=catatonit
pkgver=0.2.1
pkgrel=1
pkgdesc="Container init that is so simple it is effectively brain-dead"
arch=('x86_64')
url="https://github.com/openSUSE/catatonit"
license=('GPL-2.0-or-later')
depends=('glibc')
makedepends=('autoconf' 'automake' 'libtool')
source=("https://github.com/openSUSE/catatonit/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  autoreconf -fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
