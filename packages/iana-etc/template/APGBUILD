pkgname=iana-etc
pkgver=20260904
pkgrel=1
pkgdesc="Data for network services and protocols"
arch=('any')
url="https://github.com/Mic92/iana-etc"
license=('MIT')
depends=()
source=("https://github.com/Mic92/iana-etc/releases/download/${pkgver}/iana-etc-${pkgver}.tar.gz")

package() {
  install -dm755 "${pkgdir}/etc"
  install -m644 "${srcdir}/iana-etc-${pkgver}/protocols" "${pkgdir}/etc/protocols"
  install -m644 "${srcdir}/iana-etc-${pkgver}/services" "${pkgdir}/etc/services"
}
