pkgname=rsyslog
pkgver=8.2608.0
pkgrel=1
pkgdesc="An enhanced, multi-threaded syslog daemon"
arch=('x86_64')
url="https://www.rsyslog.com/"
license=('GPL-3.0-or-later' 'LGPL-3.0-or-later' 'Apache-2.0')
depends=('glibc' 'zlib' 'libestr' 'libfastjson')
source=("https://www.rsyslog.com/files/download/rsyslog/rsyslog-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sbindir=/usr/bin \
    --sysconfdir=/etc \
    --disable-uuid \
    --disable-gnutls \
    --disable-libgcrypt

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
