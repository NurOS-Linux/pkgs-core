pkgname=radare2
pkgver=6.2.2
pkgrel=1
pkgdesc="Open-source reverse engineering framework and command-line toolset"
arch=('x86_64')
url="https://radare.org/"
license=('LGPL-3.0-only')
depends=('glibc' 'zlib' 'openssl' 'libzip' 'xxhash')
makedepends=('meson' 'ninja' 'pkgconf')
provides=('r2')
source=("https://github.com/radareorg/radare2/archive/refs/tags/${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --buildtype=release \
    -Duse_sys_xxhash=false \
    -Duse_sys_magic=false
  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  DESTDIR="${pkgdir}" ninja -C build install
}
