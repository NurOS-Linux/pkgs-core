pkgname=libvorbis
pkgver=1.3.7
pkgrel=1
pkgdesc="Vorbis General Audio Compression Codec software library"
arch=('x86_64')
url="https://www.xiph.org/vorbis/"
license=('BSD-3-Clause')
depends=('glibc' 'libogg')
makedepends=('pkgconf')
source=("https://downloads.xiph.org/releases/vorbis/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --disable-static

  make -j"$(nproc)"
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
