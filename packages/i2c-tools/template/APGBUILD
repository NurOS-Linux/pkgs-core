pkgname=i2c-tools
pkgver=4.4
pkgrel=1
pkgdesc="Tools for I2C devices"
arch=('x86_64')
url="https://i2c.wiki.kernel.org/"
license=('GPL-2.0-or-later')
depends=('glibc')
makedepends=()
source=("https://mirrors.edge.kernel.org/pub/software/utils/i2c-tools/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make PREFIX=/usr sbindir=/usr/bin BUILD_STATIC_LIB=0 DESTDIR="${pkgdir}" install
}
