pkgname=masscan
pkgver=1.3.2
pkgrel=1
pkgdesc="Fast TCP port scanner"
arch=('x86_64')
url="https://github.com/robertdavidgraham/masscan"
license=('AGPL-3.0-only')
depends=('glibc' 'libpcap')
makedepends=()
source=("https://github.com/robertdavidgraham/masscan/archive/refs/tags/${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 bin/masscan "${pkgdir}/usr/bin/masscan"
}
