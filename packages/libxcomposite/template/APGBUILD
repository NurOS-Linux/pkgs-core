pkgname=libxcomposite
pkgver=0.4.6
pkgrel=1
pkgdesc="X11 Composite extension library"
arch=('x86_64')
url="https://xorg.freedesktop.org/"
license=('MIT')
depends=('glibc' 'libx11' 'libxfixes')
makedepends=('pkgconf')
source=("https://xorg.freedesktop.org/archive/individual/lib/libXcomposite-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/libXcomposite-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/libXcomposite-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --disable-static

  make
}

package() {
  cd "${srcdir}/libXcomposite-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
