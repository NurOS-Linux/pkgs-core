pkgname=pypi_charset_normalizer
pkgver=3.5.1
pkgrel=1
pkgdesc="The Real First Universal Charset Detector. Open, modern and actively maintained alternative to Chardet."
arch=('any')
url="https://pypi.org/project/charset-normalizer/"
license=('MIT')
depends=('python')
makedepends=('python' 'pypi_pip' 'pypi_setuptools')
provides=('charset-normalizer')
source=("https://files.pythonhosted.org/packages/e5/3f/143b048436775b0f76ac3eec145c019e8173ccc2885c8f20319b996d5e83/charset_normalizer-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/charset_normalizer-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

package() {
  cd "${srcdir}/charset_normalizer-${pkgver}"

  python3 -m pip install --no-deps --no-build-isolation --root="${pkgdir}" --prefix=/usr .
}
