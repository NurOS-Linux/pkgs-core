# Maintainer: AnmiTaliDev <anmitalidev@nuros.org>

pkgname=flex
pkgver=2.6.4
pkgrel=1
pkgdesc="A tool for generating scanners: programs which recognize lexical patterns in text"
arch=('x86_64')
url="https://github.com/westes/flex"
license=('BSD-2-Clause')
depends=('glibc' 'm4')
source=("https://github.com/westes/flex/releases/download/v${pkgver}/flex-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --disable-static \
    --docdir=/usr/share/doc/flex-${pkgver}

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  ln -sf flex "${pkgdir}/usr/bin/lex"
}
