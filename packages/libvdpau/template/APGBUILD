pkgname=libvdpau
pkgver=1.5
pkgrel=1
pkgdesc="Video Decode and Presentation API for Unix"
arch=('x86_64')
url="https://gitlab.freedesktop.org/vdpau/libvdpau"
license=('MIT')
depends=('glibc' 'libx11' 'libxext')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://gitlab.freedesktop.org/vdpau/libvdpau/-/archive/${pkgver}/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --buildtype=release \
    -Ddocumentation=false
  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  DESTDIR="${pkgdir}" ninja -C build install
}
