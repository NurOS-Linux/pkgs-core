pkgname=bat
pkgver=0.26.1
pkgrel=1
pkgdesc="A cat(1) clone with syntax highlighting and Git integration"
arch=('x86_64')
url="https://github.com/sharkdp/bat"
license=('Apache-2.0' 'MIT')
depends=('glibc' 'gcc' 'zlib')
makedepends=('cargo')
source=("https://github.com/sharkdp/bat/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cargo build --frozen --release
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/bat" "${pkgdir}/usr/bin/bat"
}
