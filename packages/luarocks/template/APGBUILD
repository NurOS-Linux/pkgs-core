pkgname=luarocks
pkgver=3.13.0
pkgrel=1
pkgdesc="Deployment and package management system for Lua modules"
arch=('any')
url="https://luarocks.org/"
license=('MIT')
depends=('lua' 'curl' 'unzip')
makedepends=()
source=("https://luarocks.org/releases/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  ./configure --prefix=/usr --sysconfdir=/etc
  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
