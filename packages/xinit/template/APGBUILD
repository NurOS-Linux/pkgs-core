pkgname=xinit
pkgver=1.4.2
pkgrel=1
pkgdesc="X Window System initializer (startx)"
arch=('x86_64')
url="https://xorg.freedesktop.org/"
license=('MIT')
depends=('glibc' 'libx11' 'xorg-server')
makedepends=('pkgconf' 'xorgproto' 'util-macros')
source=("https://xorg.freedesktop.org/releases/individual/app/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --with-xinitdir=/etc/X11/xinit

  make -j"$(nproc)"
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
