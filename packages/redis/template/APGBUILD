pkgname=redis
pkgver=8.10.2
pkgrel=1
pkgdesc="An open source, advanced key-value store"
arch=('x86_64')
url="https://redis.io/"
license=('RSALv2 OR SSPLv1')
depends=('glibc' 'openssl')
makedepends=()
source=("https://download.redis.io/releases/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make BUILD_TLS=yes
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make PREFIX="${pkgdir}/usr" install
}
