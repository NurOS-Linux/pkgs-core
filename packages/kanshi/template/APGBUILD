pkgname=kanshi
pkgver=1.7.0
pkgrel=1
pkgdesc="Dynamic display configuration for Wayland"
arch=('x86_64')
url="https://git.sr.ht/~emersion/kanshi"
license=('MIT')
depends=('glibc' 'wayland' 'libscfg')
makedepends=('meson' 'ninja' 'pkgconf' 'wayland-protocols')
source=("https://git.sr.ht/~emersion/kanshi/refs/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release \
    -Dman-pages=disabled \
    -Dipc=disabled

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
