pkgname=tumbler
pkgver=4.18.2
pkgrel=1
pkgdesc="D-Bus thumbnail service for Xfce"
arch=('x86_64')
url="https://docs.xfce.org/xfce/thunar/tumbler"
license=('GPL-2.0-or-later' 'LGPL-2.0-or-later')
depends=('glibc' 'glib' 'gdk-pixbuf' 'libpng' 'libjpeg-turbo' 'dbus')
makedepends=('pkgconf')
source=("https://archive.xfce.org/src/xfce/tumbler/4.18/tumbler-${pkgver}.tar.bz2")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --sbindir=/usr/bin \
    --disable-gtk-doc

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
