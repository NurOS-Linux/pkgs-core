pkgname=pypi_urllib3
pkgver=2.8.0
pkgrel=1
pkgdesc="HTTP library with thread-safe connection pooling, file post, and more."
arch=('any')
url="https://pypi.org/project/urllib3/"
license=('MIT')
depends=('python')
makedepends=('python' 'pypi_pip' 'pypi_hatchling' 'pypi_hatch_vcs' 'pypi_setuptools_scm')
provides=('urllib3')
source=("https://files.pythonhosted.org/packages/e3/05/b17359e1cefb4f909b5e40b1b90a496d987258916dbbf88e842c729f510e/urllib3-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/urllib3-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

package() {
  cd "${srcdir}/urllib3-${pkgver}"

  python3 -m pip install --no-deps --no-build-isolation --root="${pkgdir}" --prefix=/usr .
}
