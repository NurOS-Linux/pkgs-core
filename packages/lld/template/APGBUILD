pkgname=lld
pkgver=22.1.8
pkgrel=1
pkgdesc="High-performance linker from the LLVM project"
arch=('x86_64')
url="https://lld.llvm.org/"
license=('Apache-2.0 WITH LLVM-exception')
depends=('llvm' 'glibc' 'zlib' 'zstd')
makedepends=('llvm' 'cmake' 'ninja')
source=("https://github.com/llvm/llvm-project/releases/download/llvmorg-${pkgver}/llvm-project-${pkgver}.src.tar.xz")

prepare() {
  local dir="${srcdir}/llvm-project-${pkgver}.src"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/llvm-project-${pkgver}.src"

  cmake -B build -S lld -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DLLVM_LINK_LLVM_DYLIB=ON \
    -DLLVM_INCLUDE_TESTS=OFF

  ninja -C build -j"$(nproc)"
}

package() {
  cd "${srcdir}/llvm-project-${pkgver}.src"

  DESTDIR="${pkgdir}" ninja -C build install
}
