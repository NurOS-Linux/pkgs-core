pkgname=ttf-fira-code
pkgver=6.2
pkgrel=1
pkgdesc="Free monospaced font with programming ligatures"
arch=('any')
url="https://github.com/tonsky/FiraCode"
license=('OFL-1.1')
depends=('fontconfig')
makedepends=('unzip')
source=("https://github.com/tonsky/FiraCode/releases/download/${pkgver}/Fira_Code_v${pkgver}.zip")

prepare() {
  local dir="${srcdir}/ttf"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  :
}

package() {
  cd "${srcdir}"

  install -dm755 "${pkgdir}/usr/share/fonts/TTF"
  install -m644 ttf/*.ttf "${pkgdir}/usr/share/fonts/TTF/"

  rm -f "${pkgdir}/usr/share/info/dir"
}
