pkgname=ttf-fira-code
pkgver=6.2
pkgrel=1
pkgdesc="Free monospaced font with programming ligatures"
arch=('any')
url="https://github.com/tonsky/FiraCode"
license=('OFL')
depends=()
makedepends=('unzip')
source=("https://github.com/tonsky/FiraCode/releases/download/${pkgver}/Fira_Code_v${pkgver}.zip")

package() {
  install -dm755 "${pkgdir}/usr/share/fonts/TTF"
  find "${srcdir}" -type f -name "*.ttf" -exec install -m644 {} "${pkgdir}/usr/share/fonts/TTF/" \;
}
