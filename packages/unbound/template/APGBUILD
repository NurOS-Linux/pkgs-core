pkgname=unbound
pkgver=1.26.1
pkgrel=1
pkgdesc="Validating, recursive and caching DNS resolver"
arch=('x86_64')
url="https://nlnetlabs.nl/projects/unbound/about/"
license=('BSD-3-Clause')
depends=('glibc' 'openssl' 'libevent' 'nghttp2' 'expat')
makedepends=('pkgconf')
source=("https://nlnetlabs.nl/downloads/unbound/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --sbindir=/usr/bin \
    --disable-static \
    --with-libevent \
    --with-ssl \
    --with-libnghttp2 \
    --with-libexpat=/usr \
    --with-pthreads \
    --enable-pie \
    --enable-relro-now \
    --with-pidfile=/run/unbound.pid

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
