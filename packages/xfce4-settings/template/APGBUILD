pkgname=xfce4-settings
pkgver=4.18.4
pkgrel=1
pkgdesc="Settings manager of the Xfce desktop"
arch=('x86_64')
url="https://docs.xfce.org/xfce/xfce4-settings/start"
license=('GPL-2.0-or-later')
depends=(
  'glibc' 'glib' 'gtk3' 'libxfce4util' 'libxfce4ui' 'xfconf'
  'exo' 'garcon' 'libx11' 'libxi' 'libxrandr' 'libxcursor'
)
makedepends=('pkgconf')
source=("https://archive.xfce.org/src/xfce/xfce4-settings/4.18/xfce4-settings-${pkgver}.tar.bz2")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --sbindir=/usr/bin \
    --enable-xrandr \
    --enable-xcursor

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
