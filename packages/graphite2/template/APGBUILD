pkgname=graphite2
pkgver=1.3.15
pkgrel=1
pkgdesc="Font rendering engine for complex scripts"
arch=('x86_64')
url="https://graphite.sil.org/"
license=('LGPL-2.1-or-later')
depends=('glibc' 'gcc')
makedepends=('cmake' 'ninja')
source=("https://github.com/silnrsi/graphite/releases/download/${pkgver}/${pkgname}-${pkgver}.tgz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=/usr/lib
  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  DESTDIR="${pkgdir}" ninja -C build install
}
