pkgname=micro
pkgver=2.0.15
pkgrel=1
pkgdesc="Modern and intuitive terminal-based text editor"
arch=('x86_64')
url="https://micro-editor.github.io/"
license=('MIT')
depends=('glibc')
source=("https://github.com/zyedidia/micro/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  export GOPATH="${srcdir}/go"
  export GOCACHE="${srcdir}/go-build"
  go build -trimpath -ldflags "-s -w -X github.com/zyedidia/micro/v2/internal/util.Version=${pkgver}" ./cmd/micro
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -dm755 "${pkgdir}/usr/bin"
  install -m755 micro "${pkgdir}/usr/bin/micro"
}
