pkgname=double-conversion
pkgver=3.4.0
pkgrel=1
pkgdesc="Efficient binary-decimal and decimal-binary conversion routines for IEEE doubles"
arch=('x86_64')
url="https://github.com/google/double-conversion"
license=('BSD-3-Clause')
depends=('glibc' 'gcc')
makedepends=('cmake' 'ninja')
source=("https://github.com/google/double-conversion/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=/usr/lib \
    -DBUILD_SHARED_LIBS=ON

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
