pkgname=gping
pkgver=1.21.0
pkgrel=1
pkgdesc="Ping with a graph"
arch=('x86_64')
url="https://github.com/orf/gping"
license=('MIT')
depends=('glibc' 'gcc')
makedepends=('cargo')
source=("https://github.com/orf/gping/archive/refs/tags/gping-v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-gping-v${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-gping-v${pkgver}"

  cargo build --frozen --release -p gping
}

package() {
  cd "${srcdir}/${pkgname}-gping-v${pkgver}"

  install -Dm755 "target/release/gping" "${pkgdir}/usr/bin/gping"
}
