pkgname=hdparm
pkgver=9.65
pkgrel=1
pkgdesc="Utility to get and set ATA drive parameters"
arch=('x86_64')
url="https://sourceforge.net/projects/hdparm/"
license=('BSD-2-Clause')
depends=('glibc')
makedepends=()
source=("https://downloads.sourceforge.net/project/hdparm/hdparm/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" sbindir=/usr/bin manprefix=/usr install
}
