pkgname=libmng
pkgver=2.0.3
pkgrel=1
pkgdesc="A collection of routines used in creating and manipulating MNG image files"
arch=('x86_64')
url="https://libmng.com/"
license=('Zlib')
depends=('glibc' 'zlib' 'libjpeg-turbo' 'lcms2')
makedepends=('cmake' 'ninja')
source=("https://downloads.sourceforge.net/project/libmng/libmng-devel/${pkgver}/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=/usr/lib \
    -DBUILD_SHARED_LIBS=ON

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
