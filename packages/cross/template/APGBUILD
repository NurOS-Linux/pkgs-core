pkgname=cross
pkgver=0.2.5
pkgrel=1
pkgdesc="Zero setup cross compilation and cross testing of Rust code"
arch=('x86_64')
url="https://github.com/cross-rs/cross"
license=('Apache-2.0')
depends=('glibc' 'gcc')
makedepends=('cargo')
source=("https://github.com/cross-rs/cross/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  cargo build --frozen --release --bin cross
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -Dm755 "target/release/cross" "${pkgdir}/usr/bin/cross"
}
