pkgname=trippy
pkgver=0.13.0
pkgrel=1
pkgdesc="Network diagnostic tool"
arch=('x86_64')
url="https://trippy.cli.rs/"
license=('Apache-2.0')
depends=('glibc' 'gcc')
makedepends=('cargo')
source=("https://github.com/fujiapple852/trippy/archive/refs/tags/${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cargo build --frozen --release -p trippy
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/trip" "${pkgdir}/usr/bin/trip"
}
