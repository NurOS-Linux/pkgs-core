pkgname=atkmm
pkgver=2.28.5
pkgrel=1
pkgdesc="C++ bindings for ATK"
arch=('x86_64')
url="https://gitlab.gnome.org/GNOME/atkmm"
license=('LGPL-2.1-or-later')
depends=('glibc' 'gcc' 'glibmm' 'at-spi2-core')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://download.gnome.org/sources/atkmm/${pkgver%.*}/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release \
    -Dbuild-documentation=false

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
