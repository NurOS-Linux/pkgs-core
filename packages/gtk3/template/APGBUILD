pkgname=gtk3
pkgver=3.24.43
pkgrel=1
pkgdesc="GTK+ Graphical User Interface Library (v3)"
arch=('x86_64')
url="https://www.gtk.org/"
license=('LGPL-2.0-or-later')
depends=(
  'glibc' 'glib' 'cairo' 'pango' 'gdk-pixbuf' 'at-spi2-core'
  'libepoxy' 'libx11' 'libxext' 'libxinerama' 'libxi' 'libxrandr'
  'libxcursor' 'libxcomposite' 'libxdamage' 'libxfixes' 'shared-mime-info'
)
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://download.gnome.org/sources/gtk+/3.24/gtk+-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/gtk+-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/gtk+-${pkgver}"

  export PKG_CONFIG_PATH="/usr/lib64/pkgconfig:/usr/lib/pkgconfig:/usr/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --libdir=/usr/lib \
    --sysconfdir=/etc \
    --buildtype=release \
    --wrap-mode=nofallback \
    -Dintrospection=false \
    -Ddemos=false \
    -Dexamples=false \
    -Dtests=false \
    -Dinstalled_tests=false \
    -Dman=false \
    -Dx11_backend=true \
    -Dwayland_backend=false \
    -Dprint_backends=file \
    -Dtracker3=false

  meson compile -C build
}

package() {
  cd "${srcdir}/gtk+-${pkgver}"

  DESTDIR="${pkgdir}" meson install -C build --no-rebuild
  rm -f "${pkgdir}/usr/share/info/dir"
}
