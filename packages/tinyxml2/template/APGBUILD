pkgname=tinyxml2
pkgver=11.0.0
pkgrel=1
pkgdesc="Simple and small C++ XML parser"
arch=('x86_64')
url="https://github.com/leethomason/tinyxml2"
license=('Zlib')
depends=('glibc' 'gcc')
makedepends=('cmake' 'ninja')
source=("https://github.com/leethomason/tinyxml2/archive/refs/tags/${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DBUILD_SHARED_LIBS=ON \
    -DBUILD_TESTING=OFF

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
