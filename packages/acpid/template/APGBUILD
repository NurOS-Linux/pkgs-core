pkgname=acpid
pkgver=2.0.34
pkgrel=1
pkgdesc="Daemon for delivering ACPI events to user-space programs"
arch=('x86_64')
url="https://sourceforge.net/projects/acpid2/"
license=('GPL-2.0-or-later')
depends=('glibc')
makedepends=()
source=("https://downloads.sourceforge.net/project/acpid2/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sbindir=/usr/bin \
    --sysconfdir=/etc

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
