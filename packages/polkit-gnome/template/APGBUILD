pkgname=polkit-gnome
pkgver=0.105
pkgrel=1
pkgdesc="GTK authentication agent for polkit"
arch=('x86_64')
url="https://gitlab.gnome.org/GNOME/polkit-gnome"
license=('LGPL-2.0-or-later')
depends=('glibc' 'glib' 'gtk3' 'polkit')
makedepends=('pkgconf' 'intltool')
source=("https://download.gnome.org/sources/polkit-gnome/${pkgver}/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --disable-static

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
