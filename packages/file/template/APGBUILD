pkgname=file
pkgver=5.48
pkgrel=1
pkgdesc="File type identification utility and library"
arch=('x86_64')
url="https://astron.com/pub/file/"
license=('BSD-2-Clause')
depends=('glibc' 'zlib' 'bzip2' 'xz' 'zstd')
provides=('libmagic.so')
source=("https://astron.com/pub/file/file-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
      --prefix=/usr \
      --enable-fsect-man5 \
      --enable-zlib \
      --enable-bzlib \
      --enable-xzlib \
      --enable-zstdlib

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install

  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
