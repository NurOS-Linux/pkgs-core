pkgname=utf8proc
pkgver=2.12.0
pkgrel=1
pkgdesc="Library for processing UTF-8 encoded Unicode strings"
arch=('x86_64')
url="https://juliastrings.github.io/utf8proc/"
license=('MIT')
depends=('glibc')
makedepends=('cmake' 'ninja')
source=("https://github.com/JuliaStrings/utf8proc/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DBUILD_SHARED_LIBS=ON \
    -DUTF8PROC_ENABLE_TESTING=OFF

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
