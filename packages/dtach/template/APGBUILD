pkgname=dtach
pkgver=0.9
pkgrel=1
pkgdesc="Emulates the detach feature of screen"
arch=('x86_64')
url="https://github.com/crigler/dtach"
license=('GPL-2.0-or-later')
depends=('glibc')
makedepends=('autoconf' 'automake' 'libtool')
source=("https://github.com/crigler/dtach/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  autoreconf -fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
