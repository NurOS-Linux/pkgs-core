pkgname=zoxide
pkgver=0.10.0
pkgrel=1
pkgdesc="A smarter cd command, inspired by z and autojump"
arch=('x86_64')
url="https://github.com/ajeetdsouza/zoxide"
license=('MIT')
depends=('glibc')
makedepends=('cargo')
source=("https://github.com/ajeetdsouza/zoxide/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cargo build --frozen --release
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/zoxide" "${pkgdir}/usr/bin/zoxide"
}
