pkgname=openssh
pkgver=10.5p1
pkgrel=1
pkgdesc="Free version of the SSH connectivity tools"
arch=('x86_64')
url="https://www.openssh.com/portable.html"
license=('SSH-OpenSSH')
depends=('glibc' 'openssl' 'zlib' 'linux-pam')
install=openssh.install
source=("https://cloudflare.cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc/ssh \
    --sbindir=/usr/bin \
    --libexecdir=/usr/lib/ssh \
    --with-ssl-dir=/usr \
    --with-pam \
    --with-privsep-path=/var/empty \
    --with-privsep-user=nobody

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install-nokeys

  install -dm755 "${pkgdir}/var/empty"

  local files_dir="${startdir}/../files"
  [ -d "${files_dir}" ] || files_dir="${startdir}"
  install -Dm644 "${files_dir}/sshd.pam" "${pkgdir}/etc/pam.d/sshd"
}
