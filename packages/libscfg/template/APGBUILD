pkgname=libscfg
pkgver=0.1.1
pkgrel=1
pkgdesc="C library for the scfg configuration file format"
arch=('x86_64')
url="https://git.sr.ht/~emersion/libscfg"
license=('MIT')
depends=('glibc')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://git.sr.ht/~emersion/libscfg/refs/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
