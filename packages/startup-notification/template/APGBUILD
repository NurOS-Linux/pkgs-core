pkgname=startup-notification
pkgver=0.12
pkgrel=1
pkgdesc="Application startup notification library"
arch=('x86_64')
url="https://www.freedesktop.org/wiki/Software/startup-notification/"
license=('LGPL-2.1-only')
depends=('glibc' 'libx11' 'libxcb' 'xcb-util')
makedepends=('pkgconf' 'xorgproto')
source=("https://www.freedesktop.org/software/startup-notification/releases/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --disable-static

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
