pkgname=libglvnd
pkgver=1.7.0
pkgrel=1
pkgdesc="The GL Vendor-Neutral Dispatch library"
arch=('x86_64')
url="https://gitlab.freedesktop.org/glvnd/libglvnd"
license=('custom')
depends=('glibc' 'libx11' 'libxext')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://gitlab.freedesktop.org/glvnd/libglvnd/-/archive/v${pkgver}/libglvnd-v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-v${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-v${pkgver}"
  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --buildtype=release \
    -Dgles1=false
  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-v${pkgver}"
  DESTDIR="${pkgdir}" ninja -C build install
}
