pkgname=abduco
pkgver=0.6
pkgrel=1
pkgdesc="Session management in a clean and simple way"
arch=('x86_64')
url="https://github.com/martanne/abduco"
license=('ISC')
depends=('glibc')
makedepends=()
source=("https://github.com/martanne/abduco/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make PREFIX=/usr DESTDIR="${pkgdir}" install
}
