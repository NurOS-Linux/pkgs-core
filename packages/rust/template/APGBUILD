pkgname=rust
pkgver=1.98.1
pkgrel=1
pkgdesc="The Rust programming language toolchain and standard library sources"
arch=('x86_64')
url="https://www.rust-lang.org/"
license=('Apache-2.0 OR MIT')
depends=('glibc' 'gcc' 'binutils' 'zlib')
provides=('cargo' 'rustc' 'rust-src')
source=(
  "https://static.rust-lang.org/dist/rust-${pkgver}-x86_64-unknown-linux-gnu.tar.xz"
  "https://static.rust-lang.org/dist/rust-src-${pkgver}.tar.gz"
)

prepare() {
  local dir="${srcdir}/rust-${pkgver}-x86_64-unknown-linux-gnu"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

package() {
  cd "${srcdir}/rust-${pkgver}-x86_64-unknown-linux-gnu"

  # Install rustc, cargo, rust-std
  ./install.sh \
    --destdir="${pkgdir}" \
    --prefix=/usr \
    --disable-ldconfig

  # Clean up manifest uninstallers
  rm -rf "${pkgdir}/usr/lib/rustlib/manifest-"*
  rm -f "${pkgdir}/usr/lib/rustlib/install.log"
  rm -f "${pkgdir}/usr/lib/rustlib/uninstall.sh"

  # Install rust standard library source for kernel building (core / alloc)
  local rust_src_dir="${srcdir}/rust-src-${pkgver}/rust-src/lib/rustlib/src/rust"
  if [ -d "${rust_src_dir}" ]; then
    install -dm755 "${pkgdir}/usr/lib/rustlib/src/rust"
    cp -r "${rust_src_dir}/library" "${pkgdir}/usr/lib/rustlib/src/rust/"
  fi
}
