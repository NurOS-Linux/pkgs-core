pkgname=libva
pkgver=2.24.1
pkgrel=1
pkgdesc="Video Acceleration (VA) API for Linux"
arch=('x86_64')
url="https://github.com/intel/libva"
license=('MIT')
depends=('glibc' 'libdrm' 'libx11' 'libxext' 'libxfixes')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://github.com/intel/libva/archive/refs/tags/${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --buildtype=release \
    -Dwith_glx=yes \
    -Dwith_wayland=yes
  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  DESTDIR="${pkgdir}" ninja -C build install
}
