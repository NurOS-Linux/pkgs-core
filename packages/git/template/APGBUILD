pkgname=git
pkgver=2.48.1
pkgrel=2
pkgdesc="Fast, scalable, distributed revision control system"
arch=('x86_64')
url="https://git-scm.com/"
license=('GPL-2.0-only')
depends=('glibc' 'curl' 'expat' 'openssl' 'zlib' 'perl' 'gettext' 'tcl')
source=("https://mirrors.edge.kernel.org/pub/software/scm/git/git-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --with-curl \
    --with-expat \
    --with-openssl \
    --with-zlib=/usr

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" NO_INSTALL_HARDLINKS=1 install
}
