pkgname=acpi
pkgver=1.8
pkgrel=1
pkgdesc="ACPI client for battery, power and thermal readings"
arch=('x86_64')
url="https://sourceforge.net/projects/acpiclient/"
license=('GPL-2.0-or-later')
depends=('glibc')
makedepends=('pkgconf')
source=("https://downloads.sourceforge.net/project/acpiclient/acpiclient/${pkgver}/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
