pkgname=libslirp
pkgver=4.9.5
pkgrel=1
pkgdesc="General purpose TCP-IP emulator library"
arch=('x86_64')
url="https://gitlab.freedesktop.org/slirp/libslirp"
license=('BSD-3-Clause')
depends=('glibc' 'glib')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://gitlab.freedesktop.org/slirp/libslirp/-/archive/v${pkgver}/libslirp-v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-v${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-v${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-v${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
