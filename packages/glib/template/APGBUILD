pkgname=glib
pkgver=2.82.0
pkgrel=1
pkgdesc="Low level core library for GTK and GNOME"
arch=('x86_64')
url="https://wiki.gnome.org/Projects/GLib"
license=('LGPL-2.1-or-later')
depends=('glibc' 'zlib' 'libffi' 'pcre2')
makedepends=('meson' 'ninja' 'python' 'pkgconf')
source=("https://download.gnome.org/sources/glib/2.82/glib-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  meson setup build \
    --prefix=/usr \
    --buildtype=release \
    -Dtests=false \
    -Ddocumentation=false \
    -Dman-pages=disabled \
    -Dlibmount=disabled \
    -Dselinux=disabled \
    -Dsysprof=disabled

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
