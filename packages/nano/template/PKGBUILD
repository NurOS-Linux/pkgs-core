# Maintainer: AnmiTaliDev <anmitalidev@nuros.org>

pkgname=nano
pkgver=9.2
pkgrel=1
pkgdesc="Small and friendly text editor"
arch=('x86_64')
url="https://www.nano-editor.org/"
license=('GPL-3.0-or-later')
depends=('glibc' 'ncurses' 'file')
source=("https://www.nano-editor.org/dist/v9/nano-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
      --prefix=/usr \
      --sysconfdir=/etc \
      --enable-utf8

  make -j"$(nproc)"
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
