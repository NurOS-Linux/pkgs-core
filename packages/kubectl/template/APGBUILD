pkgname=kubectl
pkgver=1.37.1
pkgrel=1
pkgdesc="Command line tool for controlling Kubernetes clusters"
arch=('x86_64')
url="https://kubernetes.io/"
license=('Apache-2.0')
depends=('glibc')
makedepends=('go')
source=("https://github.com/kubernetes/kubernetes/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/kubernetes-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/kubernetes-${pkgver}"

  export CGO_ENABLED=0
  go build -trimpath -ldflags="-s -w" -o kubectl ./cmd/kubectl
}

package() {
  cd "${srcdir}/kubernetes-${pkgver}"

  install -Dm755 kubectl "${pkgdir}/usr/bin/kubectl"
}
