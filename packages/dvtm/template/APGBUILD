pkgname=dvtm
pkgver=0.15
pkgrel=1
pkgdesc="Dynamic virtual terminal manager"
arch=('x86_64')
url="https://github.com/martanne/dvtm"
license=('MIT')
depends=('glibc' 'ncurses')
makedepends=('pkgconf')
source=("https://github.com/martanne/dvtm/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make PREFIX=/usr
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make PREFIX=/usr DESTDIR="${pkgdir}" install
}
