pkgname=xfce4-terminal
pkgver=1.1.5
pkgrel=1
pkgdesc="Modern terminal emulator primarily for the Xfce desktop environment"
arch=('x86_64')
url="https://docs.xfce.org/apps/xfce4-terminal/start"
license=('GPL-2.0-or-later')
depends=('glibc' 'glib' 'gtk3' 'libxfce4ui' 'xfconf' 'vte3' 'pcre2')
makedepends=('pkgconf')
source=("https://archive.xfce.org/src/apps/xfce4-terminal/${pkgver%.*}/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  export PKG_CONFIG_PATH="/usr/lib/pkgconfig:/usr/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --sbindir=/usr/bin

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
