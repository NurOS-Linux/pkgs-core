pkgname=gpgme
pkgver=2.2.0
pkgrel=1
pkgdesc="GnuPG Made Easy library"
arch=('x86_64')
url="https://www.gnupg.org/software/gpgme/index.html"
license=('LGPL-2.1-or-later')
depends=('glibc' 'gnupg' 'libgpg-error' 'libassuan')
makedepends=('pkgconf')
source=("https://www.gnupg.org/ftp/gcrypt/gpgme/${pkgname}-${pkgver}.tar.bz2")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --disable-static \
    --enable-languages=cpp

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
