pkgname=svt-av1
pkgver=4.2.0
pkgrel=1
pkgdesc="Scalable Video Technology for AV1"
arch=('x86_64')
url="https://gitlab.com/AOMediaCodec/SVT-AV1"
license=('BSD-3-Clause')
depends=('glibc')
makedepends=('cmake' 'ninja' 'nasm')
source=("https://gitlab.com/AOMediaCodec/SVT-AV1/-/archive/v${pkgver}/SVT-AV1-v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/SVT-AV1-v${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/SVT-AV1-v${pkgver}"
  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_SHARED_LIBS=ON \
    -DBUILD_TESTING=OFF
  ninja -C build
}

package() {
  cd "${srcdir}/SVT-AV1-v${pkgver}"
  DESTDIR="${pkgdir}" ninja -C build install
}
