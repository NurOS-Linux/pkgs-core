pkgname=zlib
pkgver=1.3.2
pkgrel=1
pkgdesc="Compression library implementing the deflate compression method"
arch=('x86_64')
url="https://zlib.net/"
license=('Zlib')
depends=('glibc')
provides=('libz.so')
source=("https://zlib.net/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure --prefix=/usr
  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
