pkgname=alacritty
pkgver=0.17.0
pkgrel=1
pkgdesc="A cross-platform, GPU-accelerated terminal emulator"
arch=('x86_64')
url="https://alacritty.org/"
license=('Apache-2.0')
depends=('glibc' 'gcc' 'freetype' 'fontconfig' 'libxcb' 'libxkbcommon' 'wayland')
makedepends=('cargo' 'pkgconf')
source=("https://github.com/alacritty/alacritty/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cargo build --frozen --release
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/alacritty" "${pkgdir}/usr/bin/alacritty"
}
