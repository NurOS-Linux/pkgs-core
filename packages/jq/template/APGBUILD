pkgname=jq
pkgver=1.8.2
pkgrel=1
pkgdesc="Command-line JSON processor"
arch=('x86_64')
url="https://jqlang.github.io/jq/"
license=('MIT')
depends=('glibc' 'oniguruma')
makedepends=('pkgconf')
source=("https://github.com/jqlang/jq/releases/download/jq-${pkgver}/jq-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --sbindir=/usr/bin \
    --disable-maintainer-mode \
    --disable-docs

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
