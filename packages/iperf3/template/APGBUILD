pkgname=iperf3
pkgver=3.21
pkgrel=1
pkgdesc="A TCP, UDP, and SCTP network bandwidth measurement tool"
arch=('x86_64')
url="https://github.com/esnet/iperf"
license=('BSD-3-Clause')
depends=('glibc' 'openssl')
makedepends=('pkgconf')
source=("https://github.com/esnet/iperf/archive/refs/tags/${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/iperf-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/iperf-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc

  make
}

package() {
  cd "${srcdir}/iperf-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
