pkgname=pypi_installer
pkgver=1.0.1
pkgrel=1
pkgdesc="A library for installing Python wheels."
arch=('any')
url="https://pypi.org/project/installer/"
license=('MIT')
depends=('python')
makedepends=('python' 'pypi_pip' 'pypi_flit_core')
provides=('installer')
source=("https://files.pythonhosted.org/packages/06/fe/b9f481cf0cc867958a21338baa900357b7b7d86cac9b025948049d77923c/installer-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/installer-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

package() {
  cd "${srcdir}/installer-${pkgver}"

  python3 -m pip install --no-deps --no-build-isolation --root="${pkgdir}" --prefix=/usr .
}
