pkgname=pixman
pkgver=0.44.2
pkgrel=1
pkgdesc="Low-level pixel manipulation library"
arch=('x86_64')
url="https://cairographics.org/"
license=('MIT')
depends=('glibc')
makedepends=('meson' 'ninja')
source=("https://cairographics.org/releases/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --buildtype=release \
    -Dgtk=disabled

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
  rm -f "${pkgdir}/usr/share/info/dir"
}
