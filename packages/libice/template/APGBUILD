pkgname=libice
pkgver=1.1.2
pkgrel=1
pkgdesc="X11 Inter-Client Exchange library"
arch=('x86_64')
url="https://xorg.freedesktop.org/"
license=('MIT')
depends=('glibc')
makedepends=('pkgconf' 'xorgproto' 'xtrans' 'util-macros')
source=("https://xorg.freedesktop.org/releases/individual/lib/libICE-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/libICE-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/libICE-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --disable-docs \
    --disable-specs \
    --disable-static

  make -j"$(nproc)"
}

package() {
  cd "${srcdir}/libICE-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
