pkgname=acl
pkgver=2.4.0
pkgrel=1
pkgdesc="Utilities for access control lists on filesystem objects"
arch=('x86_64')
url="https://savannah.nongnu.org/projects/acl"
license=('GPL-2.0-or-later' 'LGPL-2.1-or-later')
depends=('glibc' 'attr')
makedepends=('pkgconf')
source=("https://download.savannah.nongnu.org/releases/acl/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --disable-static

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
