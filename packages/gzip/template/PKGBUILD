# Maintainer: AnmiTaliDev <anmitalidev@nuros.org>

pkgname=gzip
pkgver=1.14
pkgrel=1
pkgdesc="Standard GNU compressor"
arch=('x86_64')
url="https://www.gnu.org/software/gzip/"
license=('GPL-3.0-or-later')
depends=('glibc' 'bash')
source=("https://ftp.gnu.org/gnu/gzip/gzip-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure --prefix=/usr
  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
