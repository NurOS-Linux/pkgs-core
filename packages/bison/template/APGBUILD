pkgname=bison
pkgver=3.8.2
pkgrel=1
pkgdesc="General-purpose parser generator"
arch=('x86_64')
url="https://www.gnu.org/software/bison/"
license=('GPL-3.0-or-later')
depends=('glibc' 'm4')
source=("https://ftp.gnu.org/gnu/bison/bison-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --docdir=/usr/share/doc/bison-${pkgver}

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
