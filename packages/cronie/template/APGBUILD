pkgname=cronie
pkgver=1.7.2
pkgrel=1
pkgdesc="Daemon that runs specified programs at scheduled times"
arch=('x86_64')
url="https://github.com/cronie-crond/cronie"
license=('GPL-2.0-or-later')
depends=('glibc' 'linux-pam')
makedepends=('pkgconf')
source=("https://github.com/cronie-crond/cronie/releases/download/${pkgname}-${pkgver}/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --sbindir=/usr/bin \
    --with-pam \
    --without-audit \
    --without-selinux \
    --without-inotify

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
