pkgname=starship
pkgver=1.26.0
pkgrel=1
pkgdesc="The minimal, blazing-fast, and infinitely customizable prompt for any shell"
arch=('x86_64')
url="https://starship.rs/"
license=('ISC')
depends=('glibc' 'gcc')
makedepends=('cargo')
source=("https://github.com/starship/starship/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cargo build --frozen --release
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/starship" "${pkgdir}/usr/bin/starship"
}
