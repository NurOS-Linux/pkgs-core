pkgname=doxygen
pkgver=1.18.0
pkgrel=1
pkgdesc="A documentation system for C++, C, Java, Python, and other languages"
arch=('x86_64')
url="https://www.doxygen.nl/"
license=('GPL-2.0-only')
depends=('glibc' 'gcc')
makedepends=('cmake' 'ninja' 'python' 'flex' 'bison')
source=("https://www.doxygen.nl/files/${pkgname}-${pkgver}.src.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Dbuild_wizard=OFF
  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  DESTDIR="${pkgdir}" ninja -C build install
}
