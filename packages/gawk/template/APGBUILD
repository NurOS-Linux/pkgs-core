pkgname=gawk
pkgver=5.4.1
pkgrel=3
pkgdesc="GNU awk pattern scanning and processing language"
arch=('x86_64')
url="https://www.gnu.org/software/gawk/"
license=('GPL-3.0-or-later')
depends=('glibc' 'mpfr' 'gmp')
source=("https://ftp.gnu.org/gnu/gawk/gawk-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
      --prefix=/usr \
      --sysconfdir=/etc \
      --with-mpfr \
      --with-gmp

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" AM_UPDATE_INFO_DIR=no install
}
