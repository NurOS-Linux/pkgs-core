pkgname=exo
pkgver=4.18.0
pkgrel=1
pkgdesc="Application development library for Xfce"
arch=('x86_64')
url="https://docs.xfce.org/xfce/exo/start"
license=('GPL-2.0-or-later' 'LGPL-2.0-or-later')
depends=('glibc' 'glib' 'gtk3' 'libxfce4util' 'libxfce4ui')
makedepends=('pkgconf')
source=("https://archive.xfce.org/src/xfce/exo/4.18/exo-${pkgver}.tar.bz2")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --sbindir=/usr/bin \
    --disable-gtk-doc \
    --disable-introspection

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
