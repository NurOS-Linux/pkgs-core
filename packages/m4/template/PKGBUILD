# Maintainer: AnmiTaliDev <anmitalidev@nuros.org>

pkgname=m4
pkgver=1.4.21
pkgrel=1
pkgdesc="Traditional Unix macro processor"
arch=('x86_64')
url="https://www.gnu.org/software/m4/"
license=('GPL-3.0-or-later')
depends=('glibc')
source=("https://ftp.gnu.org/gnu/m4/m4-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure --prefix=/usr

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
