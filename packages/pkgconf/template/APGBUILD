pkgname=pkgconf
pkgver=3.0.7
pkgrel=1
pkgdesc="Package compiler and linker metadata toolkit"
arch=('x86_64')
url="https://github.com/pkgconf/pkgconf"
license=('ISC')
depends=('glibc')
provides=('pkg-config')
source=("https://distfiles.dereferenced.org/pkgconf/pkgconf-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --disable-static \
    --docdir=/usr/share/doc/pkgconf-${pkgver}

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  ln -sf pkgconf "${pkgdir}/usr/bin/pkg-config"
  ln -sf pkgconf.1 "${pkgdir}/usr/share/man/man1/pkg-config.1"
}
