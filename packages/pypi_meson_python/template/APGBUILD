pkgname=pypi_meson_python
pkgver=0.21.1
pkgrel=1
pkgdesc="The Python build backend for Meson projects"
arch=('any')
url="https://pypi.org/project/meson-python/"
license=('MIT')
depends=('python' 'meson' 'pypi_packaging' 'pypi_pyproject_metadata')
makedepends=('python' 'pypi_pip' 'meson' 'pypi_packaging' 'pypi_pyproject_metadata')
provides=('meson-python')
source=("https://files.pythonhosted.org/packages/ed/f2/ab554fe4f020ec5f0ab4e4af04318e6ab99660f8d8d14e3d064db2b786a6/meson_python-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/meson_python-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

package() {
  cd "${srcdir}/meson_python-${pkgver}"

  python3 -m pip install --no-deps --no-build-isolation --root="${pkgdir}" --prefix=/usr .
}
