# Maintainer: AnmiTaliDev <anmitalidev@nuros.org>

pkgname=tar
pkgver=1.35
pkgrel=1
pkgdesc="GNU utility for manipulating tar archives"
arch=('x86_64')
url="https://www.gnu.org/software/tar/"
license=('GPL-3.0-or-later')
depends=('glibc')
source=("https://ftp.gnu.org/gnu/tar/tar-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  FORCE_UNSAFE_CONFIGURE=1 ./configure \
      --prefix=/usr \
      --disable-acl

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
