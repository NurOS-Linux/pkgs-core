pkgname=rustup
pkgver=1.29.1
pkgrel=1
pkgdesc="The Rust toolchain installer"
arch=('x86_64')
url="https://rustup.rs/"
license=('MIT' 'Apache-2.0')
depends=('glibc' 'curl')
source=("https://static.rust-lang.org/rustup/archive/${pkgver}/x86_64-unknown-linux-gnu/rustup-init")

package() {
  install -Dm755 "${srcdir}/rustup-init" "${pkgdir}/usr/bin/rustup-init"
  ln -sf rustup-init "${pkgdir}/usr/bin/rustup"
}
