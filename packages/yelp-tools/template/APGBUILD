pkgname=yelp-tools
pkgver=42.1
pkgrel=1
pkgdesc="Tools for creating and editing Mallard and DocBook help documentation"
arch=('x86_64')
url="https://gitlab.gnome.org/GNOME/yelp-tools"
license=('GPL-2.0-or-later')
depends=('itstool' 'libxslt' 'libxml2' 'yelp-xsl')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://download.gnome.org/sources/yelp-tools/${pkgver%.*}/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
