pkgname=gnu-config
pkgver=2026.01.01
pkgrel=1
pkgdesc="GNU config.guess and config.sub scripts"
arch=('any')
url="https://git.savannah.gnu.org/cgit/config.git"
license=('GPL-3.0-or-later WITH Autoconf-exception-3.0')
depends=()
makedepends=()
source=(
  "https://git.savannah.gnu.org/cgit/config.git/plain/config.guess"
  "https://git.savannah.gnu.org/cgit/config.git/plain/config.sub"
)

package() {
  install -Dm755 "${srcdir}/config.guess" "${pkgdir}/usr/share/gnu-config/config.guess"
  install -Dm755 "${srcdir}/config.sub" "${pkgdir}/usr/share/gnu-config/config.sub"
}
