pkgname=libdisplay-info
pkgver=0.4.0
pkgrel=1
pkgdesc="EDID and DisplayID library"
arch=('x86_64')
url="https://gitlab.freedesktop.org/emersion/libdisplay-info"
license=('MIT')
depends=('glibc')
makedepends=('meson' 'ninja' 'pkgconf' 'hwdata')
source=("https://gitlab.freedesktop.org/emersion/libdisplay-info/-/archive/${pkgver}/libdisplay-info-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --buildtype=release

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
  rm -f "${pkgdir}/usr/share/info/dir"
}
