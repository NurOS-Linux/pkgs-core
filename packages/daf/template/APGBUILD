pkgname=daf
pkgver=0.2.0
pkgrel=1
pkgdesc="A simple console text editor"
arch=('x86_64')
url="https://github.com/anmitalidev/daf"
license=('GPL-3.0-or-later')
depends=('glibc')
makedepends=('meson' 'ninja')
source=("https://github.com/anmitalidev/daf/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --buildtype=release

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
