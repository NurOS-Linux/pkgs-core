pkgname=dmenu
pkgver=5.3
pkgrel=1
pkgdesc="A dynamic menu for X"
arch=('x86_64')
url="https://tools.suckless.org/dmenu/"
license=('MIT')
depends=('glibc' 'libx11' 'libxinerama' 'libxft' 'freetype')
makedepends=('pkgconf')
source=("https://dl.suckless.org/tools/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make X11INC=/usr/include X11LIB=/usr/lib FREETYPEINC=/usr/include/freetype2
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make PREFIX=/usr DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
