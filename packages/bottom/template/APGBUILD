pkgname=bottom
pkgver=0.14.9
pkgrel=1
pkgdesc="A customizable cross-platform graphical process/system monitor for the terminal"
arch=('x86_64')
url="https://github.com/ClementTsang/bottom"
license=('MIT')
depends=('glibc' 'gcc')
makedepends=('cargo')
source=("https://github.com/ClementTsang/bottom/archive/refs/tags/${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cargo build --frozen --release
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/btm" "${pkgdir}/usr/bin/btm"
}
