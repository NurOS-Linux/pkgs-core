pkgname=libliftoff
pkgver=0.5.0
pkgrel=1
pkgdesc="Lightweight KMS plane library"
arch=('x86_64')
url="https://gitlab.freedesktop.org/emersion/libliftoff"
license=('MIT')
depends=('glibc' 'libdrm')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://gitlab.freedesktop.org/emersion/libliftoff/-/archive/v${pkgver}/libliftoff-v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-v${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-v${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-v${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
