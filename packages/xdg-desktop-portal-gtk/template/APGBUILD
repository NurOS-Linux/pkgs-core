pkgname=xdg-desktop-portal-gtk
pkgver=1.15.3
pkgrel=1
pkgdesc="GTK backend for xdg-desktop-portal"
arch=('x86_64')
url="https://github.com/flatpak/xdg-desktop-portal-gtk"
license=('LGPL-2.1-or-later')
depends=('glibc' 'glib' 'gtk3' 'fontconfig' 'xdg-desktop-portal' 'gsettings-desktop-schemas')
makedepends=('meson' 'ninja' 'pkgconf' 'gettext')
source=("https://github.com/flatpak/xdg-desktop-portal-gtk/releases/download/${pkgver}/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release \
    -Dwallpaper=disabled \
    -Dsettings=enabled \
    -Dappchooser=enabled \
    -Dlockdown=enabled

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
