pkgname=unzip
pkgver=6.0
pkgrel=1
pkgdesc="For extracting and viewing files in ZIP archives"
arch=('x86_64')
url="http://infozip.sourceforge.net/UnZip.html"
license=('custom')
depends=('glibc' 'bzip2')
source=("https://downloads.sourceforge.net/project/infozip/UnZip%206.x%20%28latest%29/UnZip%206.0/unzip60.tar.gz")

prepare() {
  local dir="${srcdir}/unzip60"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/unzip60"

  make -f unix/Makefile generic \
    LOCAL_UNZIP="-DNO_LCHMOD -D_GNU_SOURCE" \
    CF="-O2 -I. -DNO_LCHMOD -D_GNU_SOURCE"
}

package() {
  cd "${srcdir}/unzip60"

  make -f unix/Makefile prefix="${pkgdir}/usr" MANDIR="${pkgdir}/usr/share/man/man1" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
