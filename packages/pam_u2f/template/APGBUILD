pkgname=pam_u2f
pkgver=1.4.0
pkgrel=1
pkgdesc="PAM module for FIDO/U2F authentication"
arch=('x86_64')
url="https://developers.yubico.com/pam-u2f/"
license=('BSD-2-Clause')
depends=('glibc' 'linux-pam' 'libfido2')
makedepends=('pkgconf')
source=("https://developers.yubico.com/pam-u2f/Releases/pam_u2f-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  ./configure --prefix=/usr --with-pam-dir=/usr/lib/security
  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
