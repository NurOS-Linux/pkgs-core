pkgname=libksba
pkgver=1.8.1
pkgrel=1
pkgdesc="Library for working with X.509 certificates and CMS data"
arch=('x86_64')
url="https://www.gnupg.org/software/libksba/index.html"
license=('LGPL-3.0-or-later')
depends=('glibc' 'libgpg-error')
makedepends=('pkgconf')
source=("https://www.gnupg.org/ftp/gcrypt/libksba/${pkgname}-${pkgver}.tar.bz2")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --disable-static

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
