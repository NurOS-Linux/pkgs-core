pkgname=pinentry
pkgver=1.3.3
pkgrel=1
pkgdesc="Collection of simple PIN or passphrase entry dialogs"
arch=('x86_64')
url="https://gnupg.org/related_software/pinentry/"
license=('GPL-2.0-or-later')
depends=('glibc' 'ncurses' 'libgpg-error' 'libassuan')
makedepends=('pkgconf')
source=("https://gnupg.org/ftp/gcrypt/pinentry/${pkgname}-${pkgver}.tar.bz2")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  ./configure \
    --prefix=/usr \
    --enable-pinentry-curses \
    --disable-pinentry-gtk2 \
    --disable-pinentry-gnome3 \
    --disable-pinentry-qt
  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
