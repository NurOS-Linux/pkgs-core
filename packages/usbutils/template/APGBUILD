pkgname=usbutils
pkgver=019
pkgrel=1
pkgdesc="USB device identification utilities"
arch=('x86_64')
url="http://linux-usb.sourceforge.net/"
license=('GPL-2.0-or-later')
depends=('glibc' 'libusb' 'eudev')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://mirrors.edge.kernel.org/pub/linux/utils/usb/usbutils/usbutils-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --buildtype=release

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
