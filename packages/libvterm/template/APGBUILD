pkgname=libvterm
pkgver=0.3.3
pkgrel=1
pkgdesc="Terminal emulator state machine library"
arch=('x86_64')
url="https://www.leonerd.org.uk/code/libvterm/"
license=('MIT')
depends=('glibc')
makedepends=('libtool' 'perl')
source=("https://www.leonerd.org.uk/code/libvterm/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make PREFIX=/usr
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make PREFIX=/usr DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}"/usr/lib/libvterm.a
}
