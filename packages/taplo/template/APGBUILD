pkgname=taplo
pkgver=0.10.0
pkgrel=1
pkgdesc="TOML toolkit and language server"
arch=('x86_64')
url="https://taplo.tamasfe.dev/"
license=('MIT')
depends=('glibc' 'gcc' 'openssl')
makedepends=('cargo' 'pkgconf')
source=("https://github.com/tamasfe/taplo/archive/refs/tags/${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cargo build --frozen --release -p taplo-cli --features lsp
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/taplo" "${pkgdir}/usr/bin/taplo"
}
