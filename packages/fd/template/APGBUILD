pkgname=fd
pkgver=10.5.0
pkgrel=1
pkgdesc="A simple, fast and user-friendly alternative to find"
arch=('x86_64')
url="https://github.com/sharkdp/fd"
license=('Apache-2.0' 'MIT')
depends=('glibc' 'gcc')
makedepends=('cargo')
source=("https://github.com/sharkdp/fd/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cargo build --frozen --release
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/fd" "${pkgdir}/usr/bin/fd"
}
