pkgname=duf
pkgver=0.9.1
pkgrel=1
pkgdesc="Disk usage utility with a friendly output"
arch=('x86_64')
url="https://github.com/muesli/duf"
license=('MIT')
depends=('glibc')
makedepends=('go')
source=("https://github.com/muesli/duf/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  export CGO_ENABLED=0
  go build -trimpath -ldflags="-s -w -X main.Version=${pkgver}" -o duf
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 duf "${pkgdir}/usr/bin/duf"
}
