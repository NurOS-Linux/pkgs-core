pkgname=lzo
pkgver=2.10
pkgrel=1
pkgdesc="Data compression library with very fast decompression"
arch=('x86_64')
url="https://www.oberhumer.com/opensource/lzo/"
license=('GPL-2.0-or-later')
depends=('glibc')
source=("https://www.oberhumer.com/opensource/lzo/download/lzo-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --enable-shared \
    --disable-static

  make -j"$(nproc)"
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/doc/lzo/COPYING"
}
