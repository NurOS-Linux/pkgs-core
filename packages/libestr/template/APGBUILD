pkgname=libestr
pkgver=0.1.11
pkgrel=1
pkgdesc="String handling essentials library for rsyslog"
arch=('x86_64')
url="https://libestr.adiscon.com/"
license=('LGPL-2.1-or-later')
depends=('glibc')
source=("https://libestr.adiscon.com/files/download/libestr-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --disable-static

  make -j"$(nproc)"
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
