pkgname=ttf-source-code-pro
pkgver=2.042
pkgrel=1
pkgdesc="Monospaced font family for user interface and coding environments from Adobe"
arch=('any')
url="https://github.com/adobe-fonts/source-code-pro"
license=('OFL-1.1')
depends=('fontconfig')
makedepends=()
provides=('source-code-pro')
source=("https://github.com/adobe-fonts/source-code-pro/archive/refs/tags/${pkgver}R-u/1.062R-i/1.026R-vf.tar.gz")

prepare() {
  local dir="${srcdir}/source-code-pro-${pkgver}R-u-1.062R-i-1.026R-vf"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

package() {
  cd "${srcdir}/source-code-pro-${pkgver}R-u-1.062R-i-1.026R-vf"

  install -dm755 "${pkgdir}/usr/share/fonts/source-code-pro"
  find TTF -name "*.ttf" -exec install -Dm644 {} "${pkgdir}/usr/share/fonts/source-code-pro/" \;
}
