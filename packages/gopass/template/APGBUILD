pkgname=gopass
pkgver=1.17.3
pkgrel=1
pkgdesc="The slightly more awesome standard unix password manager"
arch=('x86_64')
url="https://www.gopass.pw/"
license=('MIT')
depends=('glibc' 'gnupg' 'git')
makedepends=('go')
source=("https://github.com/gopasspw/gopass/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  export CGO_ENABLED=0
  go build -trimpath -ldflags="-s -w -X main.version=${pkgver}" -o gopass
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 gopass "${pkgdir}/usr/bin/gopass"
}
