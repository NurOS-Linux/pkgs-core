pkgname=sccache
pkgver=0.18.0
pkgrel=1
pkgdesc="Shared compilation cache"
arch=('x86_64')
url="https://github.com/mozilla/sccache"
license=('Apache-2.0')
depends=('glibc' 'gcc' 'openssl')
makedepends=('cargo' 'pkgconf')
source=("https://github.com/mozilla/sccache/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cargo build --frozen --release
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/sccache" "${pkgdir}/usr/bin/sccache"
}
