pkgname=gitui
pkgver=0.28.1
pkgrel=1
pkgdesc="Terminal UI for git"
arch=('x86_64')
url="https://github.com/gitui-org/gitui"
license=('MIT')
depends=('glibc' 'gcc' 'openssl' 'zlib')
makedepends=('cargo' 'pkgconf')
source=("https://github.com/gitui-org/gitui/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cargo build --frozen --release
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/gitui" "${pkgdir}/usr/bin/gitui"
}
