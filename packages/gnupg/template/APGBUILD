pkgname=gnupg
pkgver=2.5.24
pkgrel=1
pkgdesc="Complete and free implementation of the OpenPGP standard"
arch=('x86_64')
url="https://gnupg.org/"
license=('GPL-3.0-or-later')
depends=('glibc' 'zlib' 'bzip2' 'readline' 'libgpg-error' 'libgcrypt' 'libksba' 'libassuan' 'npth')
makedepends=('pkgconf')
provides=('gpg')
source=("https://gnupg.org/ftp/gcrypt/gnupg/${pkgname}-${pkgver}.tar.bz2")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --sbindir=/usr/bin \
    --enable-symcryptrun \
    --disable-doc

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
