pkgname=yarn
pkgver=1.22.22
pkgrel=1
pkgdesc="Classic Yarn package manager"
arch=('any')
url="https://www.npmjs.com/package/yarn"
license=('BSD-2-Clause')
depends=('nodejs')
makedepends=('npm')
source=("https://registry.npmjs.org/yarn/-/${pkgname}-${pkgver}.tgz")

prepare() {
  local dir="${srcdir}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

package() {
  cd "${srcdir}"

  npm install -g --prefix "${pkgdir}/usr" --no-audit --no-fund "${srcdir}/yarn-${pkgver}.tgz"
}
