pkgname=libnl
pkgver=3.12.0
pkgrel=1
pkgdesc="A collection of libraries providing APIs to netlink protocol based Linux kernel interfaces"
arch=('x86_64')
url="https://www.infradead.org/~tgr/libnl/"
license=('LGPL-2.1-only')
depends=('glibc')
makedepends=('bison' 'flex')
source=("https://github.com/thom311/libnl/releases/download/libnl3_12_0/libnl-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --sbindir=/usr/bin \
    --bindir=/usr/bin \
    --disable-static

  make -j"$(nproc)"
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
