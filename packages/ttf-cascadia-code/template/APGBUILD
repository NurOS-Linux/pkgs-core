pkgname=ttf-cascadia-code
pkgver=2407.24
pkgrel=1
pkgdesc="Monospaced font by Microsoft with programming ligatures"
arch=('any')
url="https://github.com/microsoft/cascadia-code"
license=('OFL-1.1')
depends=('fontconfig')
makedepends=()
provides=('cascadia-code')
source=("https://github.com/microsoft/cascadia-code/releases/download/v${pkgver}/CascadiaCode-${pkgver}.zip")

package() {
  install -dm755 "${pkgdir}/usr/share/fonts/cascadia"
  find "${srcdir}" -name "*.ttf" -exec install -Dm644 {} "${pkgdir}/usr/share/fonts/cascadia/" \;
}
