pkgname=libnotify
pkgver=0.8.8
pkgrel=1
pkgdesc="Library for sending desktop notifications"
arch=('x86_64')
url="https://gitlab.gnome.org/GNOME/libnotify"
license=('LGPL-2.1-or-later')
depends=('glibc' 'glib' 'gdk-pixbuf')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://download.gnome.org/sources/libnotify/${pkgver%.*}/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release \
    -Dtests=false \
    -Dintrospection=disabled \
    -Dgtk_doc=false \
    -Dman=false \
    -Ddocbook_docs=disabled

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
