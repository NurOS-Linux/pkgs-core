pkgname=font-util
pkgver=1.4.1
pkgrel=1
pkgdesc="X.Org font utilities (bdftruncate, ucs2any) and fontutil.pc"
arch=('x86_64')
url="https://xorg.freedesktop.org/"
license=('MIT')
depends=('glibc')
makedepends=('pkgconf' 'util-macros')
source=("https://xorg.freedesktop.org/releases/individual/font/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc

  make -j"$(nproc)"
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
