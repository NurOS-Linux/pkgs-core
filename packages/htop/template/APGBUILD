pkgname=htop
pkgver=3.3.0
pkgrel=1
pkgdesc="Interactive process viewer"
arch=('x86_64')
url="https://htop.dev/"
license=('GPL-2.0-or-later')
depends=('ncurses')
makedepends=('pkgconf')
source=("https://github.com/htop-dev/htop/releases/download/${pkgver}/htop-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --enable-cgroup \
    --enable-unicode

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
