pkgname=unixodbc
pkgver=2.3.14
pkgrel=1
pkgdesc="An open source ODBC sub-system"
arch=('x86_64')
url="https://www.unixodbc.org/"
license=('LGPL-2.1-or-later')
depends=('glibc' 'readline')
makedepends=()
source=("https://www.unixodbc.org/unixODBC-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/unixODBC-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/unixODBC-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --enable-gui=no

  make
}

package() {
  cd "${srcdir}/unixODBC-${pkgver}"

  make DESTDIR="${pkgdir}" install
}
