pkgname=difftastic
pkgver=0.71.0
pkgrel=1
pkgdesc="Structural diff that understands syntax"
arch=('x86_64')
url="https://difftastic.wilfred.me.uk/"
license=('MIT')
depends=('glibc' 'gcc')
makedepends=('cargo')
source=("https://github.com/Wilfred/difftastic/archive/refs/tags/${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cargo build --frozen --release
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/difft" "${pkgdir}/usr/bin/difft"
}
