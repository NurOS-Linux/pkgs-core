pkgname=polybar
pkgver=3.7.2
pkgrel=1
pkgdesc="A fast and easy-to-use tool for creating status bars"
arch=('x86_64')
url="https://polybar.github.io/"
license=('MIT')
depends=('glibc' 'gcc' 'cairo' 'libuv' 'libxcb' 'xcb-util' 'xcb-util-image' 'xcb-util-wm' 'xcb-util-xrm' 'xcb-util-cursor')
makedepends=('cmake' 'ninja' 'pkgconf' 'python')
source=("https://github.com/polybar/polybar/releases/download/${pkgver}/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}"

  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_SYSCONFDIR=/etc

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}"

  DESTDIR="${pkgdir}" ninja -C build install
}
