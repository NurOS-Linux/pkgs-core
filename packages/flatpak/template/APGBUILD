pkgname=flatpak
pkgver=1.18.3
pkgrel=1
pkgdesc="Linux application sandboxing and distribution framework"
arch=('x86_64')
url="https://flatpak.org/"
license=('LGPL-2.1-or-later')
depends=('glibc' 'glib' 'ostree' 'polkit' 'bwrap' 'fuse3' 'json-glib' 'libarchive' 'libsoup3' 'dconf')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://github.com/flatpak/flatpak/releases/download/${pkgver}/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release \
    -Dsystem_helper=disabled \
    -Ddocbook_docs=disabled \
    -Dman=disabled

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
