pkgname=libpng
pkgver=1.6.47
pkgrel=1
pkgdesc="A collection of routines used to create and manipulate PNG format images"
arch=('x86_64')
url="http://www.libpng.org/pub/png/libpng.html"
license=('Libpng')
depends=('glibc' 'zlib')
makedepends=('cmake' 'ninja' 'pkgconf')
source=("https://github.com/pnggroup/libpng/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  cmake -B build -S . \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DPNG_SHARED=ON \
    -DPNG_STATIC=OFF \
    -DPNG_TESTS=OFF

  cmake --build build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" cmake --install build
  rm -f "${pkgdir}/usr/share/info/dir"
}
