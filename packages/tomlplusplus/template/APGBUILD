pkgname=tomlplusplus
pkgver=3.4.0
pkgrel=1
pkgdesc="TOML parser and serializer for C++"
arch=('x86_64')
url="https://github.com/marzer/tomlplusplus"
license=('MIT')
depends=('glibc' 'gcc')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://github.com/marzer/tomlplusplus/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --buildtype=release \
    -Dbuild_tests=false \
    -Dbuild_examples=false

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
}
