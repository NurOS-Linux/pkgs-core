pkgname=libwnck
pkgver=43.3
pkgrel=1
pkgdesc="Window Navigator Construction Kit library for X11 desktops"
arch=('x86_64')
url="https://gitlab.gnome.org/GNOME/libwnck"
license=('LGPL-2.0-or-later')
depends=('glibc' 'glib' 'gtk3' 'cairo' 'libx11' 'libxres')
makedepends=('meson' 'ninja' 'pkgconf')
source=("https://download.gnome.org/sources/libwnck/${pkgver%.*}/libwnck-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  export PKG_CONFIG_PATH="/usr/lib/pkgconfig:/usr/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"

  rm -rf build
  meson setup build \
    --prefix=/usr \
    --buildtype=release \
    -Dintrospection=disabled \
    -Dgtk_doc=false

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
  rm -f "${pkgdir}/usr/share/info/dir"
}
