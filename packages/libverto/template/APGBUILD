pkgname=libverto
pkgver=0.3.2
pkgrel=1
pkgdesc="Event loop abstraction library"
arch=('x86_64')
url="https://github.com/latchset/libverto"
license=('MIT')
depends=('glibc' 'glib' 'libev' 'libevent')
makedepends=('pkgconf')
source=("https://github.com/latchset/libverto/releases/download/${pkgver}/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --disable-static \
    --with-glib \
    --with-libev \
    --with-libevent

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
