pkgname=libconfig
pkgver=1.7.3
pkgrel=1
pkgdesc="C/C++ Configuration File Library"
arch=('x86_64')
url="https://hyperrealm.github.io/libconfig/"
license=('LGPL-2.1-or-later')
depends=('glibc')
makedepends=('autoconf' 'automake' 'libtool')
source=("https://github.com/hyperrealm/libconfig/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  autoreconf -fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --disable-examples

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
