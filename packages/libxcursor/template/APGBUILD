pkgname=libxcursor
pkgver=1.2.3
pkgrel=1
pkgdesc="X cursor management library"
arch=('x86_64')
url="https://xorg.freedesktop.org/"
license=('MIT')
depends=('glibc' 'libx11' 'libxfixes' 'libxrender')
makedepends=('pkgconf' 'xorgproto' 'util-macros')
source=("https://xorg.freedesktop.org/releases/individual/lib/libXcursor-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/libXcursor-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/libXcursor-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --disable-static

  make -j"$(nproc)"
}

package() {
  cd "${srcdir}/libXcursor-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
