pkgname=bandwhich
pkgver=0.23.1
pkgrel=1
pkgdesc="Terminal bandwidth utilization tool"
arch=('x86_64')
url="https://github.com/imsnif/bandwhich"
license=('MIT')
depends=('glibc' 'gcc')
makedepends=('cargo')
source=("https://github.com/imsnif/bandwhich/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cargo build --frozen --release
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/bandwhich" "${pkgdir}/usr/bin/bandwhich"
}
