pkgname=sd
pkgver=1.1.0
pkgrel=1
pkgdesc="Intuitive find and replace command line tool"
arch=('x86_64')
url="https://github.com/chmln/sd"
license=('MIT')
depends=('glibc' 'gcc')
makedepends=('cargo')
source=("https://github.com/chmln/sd/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cargo build --frozen --release
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/sd" "${pkgdir}/usr/bin/sd"
}
