pkgname=harfbuzz
pkgver=10.4.0
pkgrel=1
pkgdesc="OpenType text shaping engine"
arch=('x86_64')
url="https://harfbuzz.github.io/"
license=('MIT')
depends=('glibc' 'freetype' 'glib')
makedepends=('meson' 'ninja' 'pkgconf' 'python')
source=("https://github.com/harfbuzz/harfbuzz/releases/download/${pkgver}/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  meson setup build \
    --prefix=/usr \
    --buildtype=release \
    -Ddocs=disabled \
    -Dtests=disabled \
    -Dbenchmark=disabled \
    -Dintrospection=disabled

  ninja -C build
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  DESTDIR="${pkgdir}" ninja -C build install
  rm -f "${pkgdir}/usr/share/info/dir"
}
