pkgname=findutils
pkgver=4.11.0
pkgrel=2
pkgdesc="GNU utilities for finding files"
arch=('x86_64')
url="https://www.gnu.org/software/findutils/"
license=('GPL-3.0-or-later')
depends=('glibc')
source=("https://ftp.gnu.org/gnu/findutils/findutils-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
      --prefix=/usr \
      --localstatedir=/var/lib/locate

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" AM_UPDATE_INFO_DIR=no install
}
