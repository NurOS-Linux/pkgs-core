pkgname=tcpdump
pkgver=4.99.7
pkgrel=1
pkgdesc="Powerful command-line packet analyzer"
arch=('x86_64')
url="https://www.tcpdump.org/"
license=('BSD-3-Clause')
depends=('glibc' 'libpcap' 'openssl')
makedepends=('pkgconf')
source=("https://www.tcpdump.org/release/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --sbindir=/usr/bin

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
