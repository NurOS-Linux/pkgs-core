pkgname=ostree
pkgver=2026.4
pkgrel=1
pkgdesc="Operating system and container binary deployment and upgrades"
arch=('x86_64')
url="https://ostreedev.github.io/ostree/"
license=('LGPL-2.0-or-later')
depends=(
  'glibc' 'glib' 'curl' 'openssl' 'gpgme' 'libarchive' 'fuse3' 'xz'
  'e2fsprogs' 'zlib'
)
makedepends=('pkgconf' 'bison')
source=("https://github.com/ostreedev/ostree/releases/download/v${pkgver}/libostree-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/libostree-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/libostree-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --disable-static \
    --with-curl \
    --with-openssl \
    --with-libarchive \
    --without-soup \
    --without-selinux \
    --without-libsystemd \
    --disable-gtk-doc \
    --disable-man

  make
}

package() {
  cd "${srcdir}/libostree-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
