pkgname=docker-compose
pkgver=5.5.1
pkgrel=1
pkgdesc="Define and run multi-container applications with Docker"
arch=('x86_64')
url="https://github.com/docker/compose"
license=('Apache-2.0')
depends=('glibc' 'docker')
makedepends=('go')
source=("https://github.com/docker/compose/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/compose-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/compose-${pkgver}"

  export CGO_ENABLED=0
  go build -trimpath -ldflags="-s -w -X github.com/docker/compose/v5/internal.Version=v${pkgver}" -o docker-compose ./cmd
}

package() {
  cd "${srcdir}/compose-${pkgver}"

  install -Dm755 docker-compose "${pkgdir}/usr/bin/docker-compose"
}
