pkgname=linux
pkgver=7.2.3
pkgrel=1
pkgdesc="The Linux kernel and modules for NurOS"
arch=('x86_64')
url="https://www.kernel.org/"
license=('GPL-2.0-only')
depends=('kmod')
optdepends=(
  'mkinitcpio: Modular initramfs image creation utility'
  'linux-firmware: Firmware files for built-in and modular hardware drivers'
)
makedepends=('bc' 'bison' 'flex' 'openssl' 'kmod' 'rsync' 'rust' 'rust-bindgen' 'llvm' 'elfutils')
source=(
  "https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-${pkgver}.tar.xz"
  "config.x86_64"
  "linux.preset"
)

prepare() {
  local dir="${srcdir}/linux-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  make mrproper

  # Deploy NurOS kernel configuration
  cp "${srcdir}/config.x86_64" .config
  make olddefconfig
}

build() {
  cd "${srcdir}/linux-${pkgver}"

  make -j"$(nproc)" bzImage modules
}

package() {
  cd "${srcdir}/linux-${pkgver}"

  # 1. Install kernel binary, System.map and config into /boot
  install -dm755 "${pkgdir}/boot"
  install -m644 arch/x86/boot/bzImage "${pkgdir}/boot/vmlinuz-nuros"
  ln -sf vmlinuz-nuros "${pkgdir}/boot/vmlinuz"

  install -m644 System.map "${pkgdir}/boot/System.map-${pkgver}"
  ln -sf "System.map-${pkgver}" "${pkgdir}/boot/System.map"

  install -m644 .config "${pkgdir}/boot/config-${pkgver}"

  # 2. Install modules into /usr/lib/modules/${pkgver} (UsrMerge)
  make INSTALL_MOD_PATH="${pkgdir}/usr" INSTALL_MOD_STRIP=1 modules_install

  # 3. Clean up build and source symlinks pointing to build environment
  find "${pkgdir}/usr/lib/modules" -maxdepth 2 -type l \( -name build -o -name source \) -delete

  # 4. Install mkinitcpio preset
  install -Dm644 "${srcdir}/linux.preset" "${pkgdir}/etc/mkinitcpio.d/linux.preset"
}
