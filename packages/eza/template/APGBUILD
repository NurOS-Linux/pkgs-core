pkgname=eza
pkgver=0.23.5
pkgrel=1
pkgdesc="A modern, maintained replacement for ls"
arch=('x86_64')
url="https://github.com/eza-community/eza"
license=('EUPL-1.2')
depends=('glibc' 'gcc')
makedepends=('cargo')
source=("https://github.com/eza-community/eza/archive/refs/tags/v${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi

  cd "${dir}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  cargo build --frozen --release --no-default-features
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  install -Dm755 "target/release/eza" "${pkgdir}/usr/bin/eza"
}
