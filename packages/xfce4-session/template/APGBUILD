pkgname=xfce4-session
pkgver=4.18.4
pkgrel=1
pkgdesc="Session manager for Xfce"
arch=('x86_64')
url="https://docs.xfce.org/xfce/xfce4-session/start"
license=('GPL-2.0-or-later')
depends=(
  'glibc' 'glib' 'gtk3' 'libxfce4util' 'libxfce4ui' 'xfconf'
  'libwnck' 'libsm' 'libice' 'polkit'
)
makedepends=('pkgconf')
source=("https://archive.xfce.org/src/xfce/xfce4-session/4.18/xfce4-session-${pkgver}.tar.bz2")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --sbindir=/usr/bin \
    --disable-gtk-doc \
    --disable-systemd

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
