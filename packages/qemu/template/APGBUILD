pkgname=qemu
pkgver=11.1.1
pkgrel=1
pkgdesc="A generic and open source machine emulator and virtualizer"
arch=('x86_64')
url="https://www.qemu.org/"
license=('GPL-2.0-only')
depends=('glibc' 'glib' 'zlib' 'pixman' 'libslirp' 'alsa-lib')
makedepends=('python' 'meson' 'ninja' 'pkgconf')
source=("https://download.qemu.org/${pkgname}-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --target-list=x86_64-softmmu,x86_64-linux-user \
    --audio-drv-list=alsa \
    --disable-docs \
    --disable-gtk
  make -j"$(nproc)"
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
}
