pkgname=opensc
pkgver=0.27.1
pkgrel=1
pkgdesc="Tools and libraries for smart cards"
arch=('x86_64')
url="https://github.com/OpenSC/OpenSC"
license=('LGPL-2.1-or-later')
depends=('glibc' 'openssl' 'pcsc-lite' 'readline' 'zlib')
makedepends=('pkgconf')
source=("https://github.com/OpenSC/OpenSC/releases/download/${pkgver}/${pkgname}-${pkgver}.tar.gz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --disable-static \
    --disable-notify \
    --disable-autostart-items \
    --disable-man \
    --disable-doc

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
