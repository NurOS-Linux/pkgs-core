pkgname=shadow
pkgver=4.20.2
pkgrel=1
pkgdesc="Password and account management tool suite"
arch=('x86_64')
url="https://github.com/shadow-maint/shadow"
license=('BSD-3-Clause' 'GPL-2.0-or-later')
depends=('glibc' 'linux-pam')
source=("https://github.com/shadow-maint/shadow/releases/download/${pkgver}/shadow-${pkgver}.tar.xz")

prepare() {
  local dir="${srcdir}/${pkgname}-${pkgver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  ./configure \
      --prefix=/usr \
      --sysconfdir=/etc \
      --bindir=/usr/bin \
      --sbindir=/usr/bin \
      --with-libpam \
      --without-selinux \
      --without-acl \
      --without-libbsd \
      --disable-logind \
      --disable-static

  make
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" install

  if [ -d "${pkgdir}/usr/sbin" ]; then
    mv "${pkgdir}/usr/sbin"/* "${pkgdir}/usr/bin/"
    rmdir "${pkgdir}/usr/sbin"
  fi
}
