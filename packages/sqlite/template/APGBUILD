pkgname=sqlite
pkgver=3.53.4
_srcver=3530400
pkgrel=1
pkgdesc="A C library that implements an SQL database engine"
arch=('x86_64')
url="https://www.sqlite.org/"
license=('blessing')
depends=('glibc' 'readline' 'zlib')
source=("https://www.sqlite.org/2026/sqlite-autoconf-${_srcver}.tar.gz")

prepare() {
  local dir="${srcdir}/sqlite-autoconf-${_srcver}"
  if [ ! -d "${dir}" ]; then
    echo "Error: ${dir} not found" >&2
    return 1
  fi
}

build() {
  cd "${srcdir}/sqlite-autoconf-${_srcver}"

  export CPPFLAGS="-DSQLITE_ENABLE_COLUMN_METADATA=1 \
                   -DSQLITE_ENABLE_UNLOCK_NOTIFY=1 \
                   -DSQLITE_ENABLE_DBSTAT_VTAB=1 \
                   -DSQLITE_ENABLE_FTS3=1 \
                   -DSQLITE_ENABLE_FTS4=1 \
                   -DSQLITE_ENABLE_FTS5=1 \
                   -DSQLITE_ENABLE_RTREE=1 \
                   -DSQLITE_ENABLE_JSON1=1 \
                   -DSQLITE_SECURE_DELETE=1 \
                   -DSQLITE_USE_URI=1"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --enable-threadsafe \
    --enable-readline \
    --enable-dynamic-extensions \
    --disable-static

  make -j"$(nproc)"
}

package() {
  cd "${srcdir}/sqlite-autoconf-${_srcver}"

  make DESTDIR="${pkgdir}" install
  rm -f "${pkgdir}/usr/share/info/dir"
}
